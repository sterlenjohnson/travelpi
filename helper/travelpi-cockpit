def power_status():
    result = {'state': 'unknown', 'temperature_c': None, 'throttled': None, 'detail': 'Power telemetry unavailable.'}
    result['signal'] = 'unavailable'
    result['raw_throttled'] = None
    for field in THROTTLE_FLAG_FIELDS:
        result[field] = None
    result['core_volts'] = None
    result['clock_synced'] = None
    result['storage_risk'] = 'ok'
    result['power_loss_count'] = None
    result.update(current_sensor_reading())
    result.update(usb_otg_status())
    result.update(power_recorder_status())
    result['clock_synced'] = clock_synced()
    try:
        result['governor'] = Path('/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor').read_text().strip()
    except OSError:
        result['governor'] = None
    journal_events = journal_power_events()
    if journal_events['fs_errors']:
        result['storage_risk'] = 'high'
    elif result['power_loss_count']:
        result['storage_risk'] = 'elevated'
    try:
        temperature = text(['/usr/bin/vcgencmd', 'measure_temp'])
        match = re.search(r'temp=([0-9.]+)', temperature)
        if match:
            result['temperature_c'] = float(match.group(1))
    except Exception:
        try:
            result['temperature_c'] = round(int(Path('/sys/class/thermal/thermal_zone0/temp').read_text()) / 1000, 1)
        except Exception:
            pass
    try:
        volts = text(['/usr/bin/vcgencmd', 'measure_volts', 'core'])
        result['core_volts'] = parse_core_volts(volts)
    except Exception:
        pass
    try:
        throttled = text(['/usr/bin/vcgencmd', 'get_throttled'])
        match = re.search(r'0x([0-9a-f]+)', throttled, re.I)
        if match:
            value = int(match.group(1), 16)
            decoded = decode_throttle_bits(value)
            result['throttled'] = '0x' + format(value, 'x')
            result['raw_throttled'] = result['throttled']
            result['signal'] = decoded['signal']
            for field in THROTTLE_FLAG_FIELDS:
                result[field] = decoded[field]
            result['state'] = 'ok' if decoded['signal'] == 'clean' else 'warning'
            result['detail'] = THROTTLE_DETAILS[decoded['signal']]
    except Exception:
        pass
    if result['state'] == 'unknown' and result['temperature_c'] is not None:
        result['state'] = 'ok'
        result['detail'] = 'Temperature is available; power flags are unavailable.'
    if result['unexpected_shutdown'] is True:
        if result['state'] == 'ok':
            result['state'] = 'warning'
        result['detail'] = ('Unexpected shutdown: the previous boot ended without a '
                            'clean-shutdown marker (power loss). ' + result['detail'])
    return result


def pressure_status():
    try:
        load_1m = float(Path('/proc/loadavg').read_text().split()[0])
    except Exception:
        load_1m = None
    memory = {}
    try:
        for line in Path('/proc/meminfo').read_text().splitlines():
            key, value = line.split(':', 1)
            if key == 'MemAvailable':
                memory[key] = int(value.strip().split()[0]) // 1024
                break
    except Exception:
        pass
    available_mb = memory.get('MemAvailable')
    pressured = (load_1m is not None and load_1m >= 4.0) or (available_mb is not None and available_mb < 64)
    return {'load_1m': load_1m, 'memory_available_mb': available_mb, 'pressured': pressured}


def subnet_overlaps():
    """Warn when the WAN or wired uplink prefix collides with the AP LAN
    (192.168.200.0/24) or with each other: a hotel handing out the same
    range breaks forwarding and the subnet-router advertisement."""
    nets = {}
    for label, value in (('WAN ' + WAN, ipv4_address(WAN)), ('wired eth0', ipv4_address('eth0'))):
        try:
            if value:
                nets[label] = ipaddress.ip_interface(value).network
        except ValueError:
            continue
    ap_net = ipaddress.ip_interface(AP_ADDRESS).network
    named = [('AP LAN ' + LAN, ap_net)] + list(nets.items())
    warnings = []
    for i, (name_a, net_a) in enumerate(named):
        for name_b, net_b in named[i + 1:]:
            if net_a.overlaps(net_b):
                warnings.append('Subnet overlap: %s (%s) overlaps %s (%s)' % (name_a, net_a, name_b, net_b))
    return warnings


def health_status():
    pressure = pressure_status()
    load_1m = pressure.get('load_1m')
    memory = {}
    try:
        for line in Path('/proc/meminfo').read_text().splitlines():
            key, value = line.split(':', 1)
            if key in ('MemAvailable', 'MemTotal', 'SwapFree', 'SwapTotal'):
                memory[key] = int(value.strip().split()[0]) // 1024
    except Exception:
        pass
    swap_total = memory.get('SwapTotal', 0)
    swap_used = max(0, swap_total - memory.get('SwapFree', swap_total))
    mem_total = memory.get('MemTotal', 0)
    mem_available = memory.get('MemAvailable')
    mem_used_percent = (round(100 * (mem_total - mem_available) / mem_total, 1)
                        if mem_total and mem_available is not None else None)
    swap_used_percent = (round(100 * swap_used / swap_total, 1) if swap_total else None)
    try:
        disk = shutil.disk_usage('/')
        disk_used_percent = round((disk.used / disk.total) * 100, 1) if disk.total else None
    except OSError:
        disk_used_percent = None
    journal_events = journal_power_events()
    return {'load_1m': load_1m, 'memory_available_mb': memory.get('MemAvailable'),
            'memory_total_mb': mem_total, 'swap_total_mb': swap_total,
            'swap_free_mb': memory.get('SwapFree'),
            'memory_used_percent': mem_used_percent, 'swap_used_percent': swap_used_percent,
            'swap_used_mb': swap_used, 'disk_used_percent': disk_used_percent,
            'portal': portal_status(),
            'subnet_overlaps': subnet_overlaps(),
            'pressured': pressure.get('pressured', False), 'power': power_status(),
            'firmware_overrides': firmware_config_overrides(),
            'throttle_events': journal_events['throttle_events'],
            'radio_reset_events': journal_events['radio_reset_events'],
            'radio_link_events': journal_events['radio_link_events'],
            **radio_watchdog_status(),
            **memguard_status()}


def parse_tailscale_status(payload):
    self_info = payload.get('Self') if isinstance(payload, dict) else {}
    self_info = self_info if isinstance(self_info, dict) else {}
    peers = payload.get('Peer', {}) if isinstance(payload, dict) else {}
    peers = peers if isinstance(peers, dict) else {}
    exit_status = payload.get('ExitNodeStatus', {}) if isinstance(payload, dict) else {}
    exit_status = exit_status if isinstance(exit_status, dict) else {}
    ips = self_info.get('TailscaleIPs') or []
    peer_list = []
    for peer in peers.values():
        if not isinstance(peer, dict):
            continue
        peer_ips = peer.get('TailscaleIPs') or []
        peer_list.append({
            'name': peer.get('HostName') or str(peer.get('DNSName') or '').split('.')[0],
            'ip': peer_ips[0] if peer_ips else None,
            'online': bool(peer.get('Online')),
        })
    return {'state': payload.get('BackendState', 'unknown'),
            'backend_state': payload.get('BackendState', 'unknown'),
            'addresses': [str(ip) for ip in ips if isinstance(ip, str)],
            'peer_count': len(peers),
            'peers': peer_list[:16],
            'exit_node': exit_status.get('HostName') or exit_status.get('ID'),
            'exit_node_active': bool(exit_status.get('Online')),
            'transport': 'relay' if any(isinstance(peer, dict) and peer.get('Relay') for peer in peers.values()) else 'direct-or-unknown',
            'auth_url': payload.get('AuthURL'),
            'needs_login': payload.get('BackendState') != 'Running'}


def parse_wireguard_dump(output):
    lines = [line.split('\t') for line in (output or '').splitlines() if line.strip()]
    peers = lines[1:] if lines else []
    routes = []
    endpoints = []
    latest_handshake = None
    for peer in peers:
        if len(peer) >= 3:
            endpoints.append(peer[2]) if peer[2] else None
        if len(peer) >= 4 and peer[3]:
            routes.extend(item for item in peer[3].split(',') if item)
        if len(peer) >= 5 and peer[4].isdigit():
            latest_handshake = max(latest_handshake or 0, int(peer[4]))
    return {'state': 'active' if lines else 'inactive', 'peer_count': len(peers),
            'routes': routes, 'endpoints': endpoints, 'latest_handshake': latest_handshake}


TAILSCALE_STATUS_CACHE = '/tmp/travelpi-%d-%s' % (os.geteuid(), 'tailscale-status.json')
TAILSCALE_STATUS_TTL = 30


def ap_wifi6():
    """Whether the AP serves Wi-Fi 6 (HE): hostapd.conf ieee80211ax=1 is the
    configured truth; when the config is unreadable (the unprivileged status
    path), fall back to the radio's reported HE capability."""
    try:
        for line in HOSTAPD.read_text(errors='replace').splitlines():
            if line.strip().startswith('ieee80211ax='):
                return line.strip().split('=', 1)[1].strip() == '1'
        return False
    except OSError:
        return 'wifi6' in (radio_phy_capabilities(LAN).get('capabilities') or [])


def ap_evidence():
    """Carrier and associated-station evidence for the AP interface — the unit
    being active is not the same as the AP working (2026-10-27 incident: hostapd
    'active' while wlan1 sat NO-CARRIER after the USB radio flapped)."""
    carrier = None
    try:
        carrier = Path('/sys/class/net/' + LAN + '/carrier').read_text().strip() == '1'
    except (OSError, ValueError):
        pass
    stations = None
    try:
        dump = text(['/usr/sbin/iw', 'dev', LAN, 'station', 'dump'], timeout=10)
        stations = sum(1 for line in dump.splitlines() if line.startswith('Station '))
    except Exception:
        pass
    return {'carrier': carrier, 'stations': stations}


def cached_tailscale_status():
    """Return Tailscale status JSON, cached briefly to avoid the slow CLI on every poll."""
    cached = fresh_cache(TAILSCALE_STATUS_CACHE, ('payload',), TAILSCALE_STATUS_TTL)
    if cached and isinstance(cached['payload'], dict):
        return cached['payload']
    payload = json_lines(text(['/usr/bin/tailscale', 'status', '--json'])) or {}
    store_cache(TAILSCALE_STATUS_CACHE, payload=payload)
    return payload


def vpn_status():
    states = {provider: service_state(unit) for provider, unit in VPN_UNITS.items()}
    openvpn_state = service_state(OPENVPN_UNIT)
    providers = {provider: {'provider': provider, 'state': states[provider], 'available': True}
                 for provider in VPN_UNITS}
    providers['openvpn'] = {'provider': 'openvpn', 'state': openvpn_state,
                            'available': unit_available(OPENVPN_UNIT)}
    if states['tailscale'] == 'active':
        try:
            payload = cached_tailscale_status() or {}
            providers['tailscale'].update(parse_tailscale_status(payload))
            providers['tailscale']['state'] = states['tailscale']
        except Exception:
            providers['tailscale']['detail_error'] = 'Provider detail unavailable'
    if states['wireguard'] == 'active':
        try:
            details = parse_wireguard_dump(text(['/usr/bin/wg', 'show', 'wg0', 'dump']))
            details.pop('state', None)
            providers['wireguard'].update(details)
            providers['wireguard']['addresses'] = [ipv4_address('wg0')] if ipv4_address('wg0') else []
        except Exception:
            providers['wireguard']['detail_error'] = 'Provider detail unavailable'
    active = []
    for provider, item in providers.items():
        if item.get('state') != 'active':
            continue
        if provider == 'tailscale' and item.get('backend_state') not in (None, 'Running'):
            continue
        active.append(provider)
    selected = active[0] if active else 'tailscale'
    return {'selected': selected, 'states': states, 'active': active, 'providers': providers,
            'summary': ', '.join(provider.title() for provider in active) if active else 'Off'}


def ipv6_status():
    def global_address(interface):
        # A real global unicast address (2000::/3). ULAs (fc00::/7, including
        # the ULA the AP advertises) also carry "scope global" in
        # `ip`, so scope alone cannot tell the two apart.
        try:
            output = text(['/sbin/ip', '-6', '-o', 'addr', 'show', 'dev', interface, 'scope', 'global'])
        except Exception:
            return False
        return bool(re.search(r'inet6\s+[23][0-9a-f]{0,3}:[0-9a-f:]*/', output, re.I))

    try:
        route = text(['/sbin/ip', '-6', 'route', 'show', 'default', 'dev', WAN])
    except Exception:
        route = ''
    wan_global = global_address(WAN)
    ap_global = global_address(LAN)
    try:
        ap_ula = bool(re.search(r'inet6\s+f[cd][0-9a-f]{0,2}:',
                                text(['/sbin/ip', '-6', '-o', 'addr', 'show', 'dev', LAN, 'scope', 'global']), re.I))
    except Exception:
        ap_ula = False
    ula_configured = ula_prefix() is not None
    ra_off = Path(AP_RA_OFF_DROPIN).exists()
    # RAs are live only when systemd-networkd (ADR 0006) is running and the
    # installed AP profile exists; the ra-off drop-in switches them off.
    networkd_up = service_state('systemd-networkd') == 'active' and Path(AP_NETWORK_FILE).exists()
    ra_live = networkd_up and not ra_off
    # ADR 0007: the DHCPv6-PD client is not implemented, so 'active'
    # (delegated global addressing) is never claimed. ap_global / wan_global
    # stay as observed facts.
    if not ula_configured and not ap_ula and not ap_global:
        state = 'off'
        detail = ('No ULA prefix is configured (' + ULA_PREFIX_FILE + '); LAN devices get no IPv6 addresses '
                  'until make deploy or travelpi-ula-init creates it.')
    elif ra_live:
        state = 'ula-only'
        if wan_global:
            detail = ('The WAN has global IPv6, but LAN devices only get ULA (private IPv6) addresses: '
                      'no global prefix is delegated to the AP yet.')
        else:
            detail = 'Router advertisements are live: LAN devices get ULA (private IPv6) addresses; no global delegation yet.'
    elif ra_off:
        state = 'off'
        detail = 'Router advertisements stopped; no IPv6 addressing advertised on the LAN.'
    else:
        state = 'off'
        detail = ('Router advertisements are not running: systemd-networkd is not active or the AP profile ('
                  + AP_NETWORK_FILE + ') is not installed.')
    return {'state': state, 'detail': detail, 'wan_global': wan_global,
            'ap_global': ap_global, 'default_route': bool(route), 'mutable': True}


