def parse_link(interface):
    try:
        output = text(['/sbin/iw', 'dev', interface, 'link'])
    except Exception:
        return {}
    data = {}
    for line in output.splitlines():
        line = line.strip()
        if line.startswith('SSID:'):
            data['ssid'] = line.split(':', 1)[1].strip()
        elif line.startswith('freq:'):
            data['freq'] = int(float(line.split(':', 1)[1].strip()))
        elif line.startswith('signal:'):
            data['signal_dbm'] = int(line.split(':', 1)[1].strip().split()[0])
        elif line.startswith('tx bitrate:'):
            data['tx_bitrate'] = line.split(':', 1)[1].strip()
        elif line.startswith('rx bitrate:'):
            data['rx_bitrate'] = line.split(':', 1)[1].strip()
    return data


def parse_ap(interface):
    data = {}
    try:
        output = text(['/sbin/iw', 'dev', interface, 'info'])
    except Exception:
        return data
    for line in output.splitlines():
        line = line.strip()
        if line.startswith('ssid '):
            data['ssid'] = line[5:].strip()
        elif line.startswith('channel '):
            match = re.search(r'channel\s+(\d+)\s+\((\d+)\s+MHz\)(?:, width:\s*([^,]+))?', line)
            if match:
                data['channel'] = int(match.group(1))
                data['freq'] = int(match.group(2))
                if match.group(3):
                    data['width'] = match.group(3).strip()
        elif line.startswith('txpower '):
            data['txpower_dbm'] = line.split()[1]
        elif line.startswith('type '):
            data['type'] = line[5:].strip()
    return data


def clients():
    items = []
    by_mac = {}
    try:
        leases = Path('/var/lib/misc/dnsmasq.leases').read_text(errors='replace')
    except Exception:
        leases = ''
    for line in leases.splitlines():
        parts = line.split()
        if len(parts) >= 4:
            item = {'mac': parts[1], 'ip': parts[2], 'hostname': parts[3]}
            by_mac[parts[1].lower()] = item
            items.append(item)
    try:
        station = text(['/sbin/iw', 'dev', LAN, 'station', 'dump'])
    except Exception:
        station = ''
    current = None
    for line in station.splitlines():
        stripped = line.strip()
        if stripped.startswith('Station '):
            mac = stripped.split()[1].lower()
            current = by_mac.get(mac)
            if current is None:
                current = {'mac': mac, 'ip': None, 'hostname': None}
                items.append(current)
            current['signal_dbm'] = stripped.split('signal: ', 1)[1].split()[0] if 'signal: ' in stripped else current.get('signal_dbm')
        elif current is not None and stripped.startswith('signal:'):
            current['signal_dbm'] = stripped.split(':', 1)[1].strip().split()[0]
        elif current is not None and stripped.startswith('tx bitrate:'):
            current['tx_bitrate'] = stripped.split(':', 1)[1].strip()
        elif current is not None and stripped.startswith('rx bitrate:'):
            current['rx_bitrate'] = stripped.split(':', 1)[1].strip()
    return {'count': len(items), 'items': items[:64]}


