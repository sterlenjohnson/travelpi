def route_status_for(interface):
    try:
        output = text(['/sbin/ip', '-4', 'route', 'show', 'default', 'dev', interface])
    except Exception:
        return {}
    for line in output.splitlines():
        if not re.match(r'^default(?:\s|$)', line):
            continue
        gateway = re.search(r'\bvia\s+(\S+)', line)
        return {'interface': interface, 'gateway': gateway.group(1) if gateway else None}
    return {}


PROBE_TARGET_RE = re.compile(r'^[A-Za-z0-9.\-]{1,253}$')


def validate_probe_target(target):
    if not isinstance(target, str):
        return None
    target = target.strip().lower()
    if not target or target.startswith('http://') or target.startswith('https://') \
            or '/' in target or ':' in target or ' ' in target:
        return None
    if not PROBE_TARGET_RE.match(target):
        return None
    return target


def fixed_http_probe(target):
    """Run the interface-bound HTTP check against the given host."""
    started = time.monotonic()
    url = 'http://' + target + '/'
    try:
        result = run([
            '/usr/bin/curl',
            '--interface', WAN,
            '--ipv4',
            '--connect-timeout', '4',
            '--max-time', str(WAN_PROBE_TIMEOUT),
            '--silent',
            '--show-error',
            '--output', '/dev/null',
            '--write-out', '%{http_code} %{redirect_url}',
            '--url', url,
        ], timeout=WAN_PROBE_TIMEOUT + 2)
    except (OSError, subprocess.TimeoutExpired):
        return {'http_status': None, 'redirect_url': '', 'returncode': None,
                'duration_ms': round((time.monotonic() - started) * 1000)}

    match = re.fullmatch(r'\s*(\d{3})(?:\s+(\S*))?\s*', result.stdout or '')
    return {
        'http_status': int(match.group(1)) if match else None,
        'redirect_url': (match.group(2) or '') if match else '',
        'returncode': result.returncode,
        'duration_ms': round((time.monotonic() - started) * 1000),
    }


def probe_result(state, *, associated, address=None, route=None, http_status=None, duration_ms=None, target='google.com'):
    probe = {
        'interface': WAN,
        'status': state,
        'target': target,
        'url': 'http://' + target + '/',
        'associated': associated,
        'ip': address,
        'gateway': (route or {}).get('gateway'),
        'http_status': http_status,
    }
    if duration_ms is not None:
        probe['duration_ms'] = duration_ms
    if associated:
        probe['association'] = 'ASSOCIATED'
    return {
        'ok': True,
        'action': 'probe',
        'message': 'WAN probe completed: ' + state,
        'status': state,
        'probe': probe,
    }


def probe(target='google.com'):
    """Return a bounded WAN health result against the given host (default google.com)."""
    link = parse_link(WAN)
    if not link:
        return probe_result('ASSOCIATION_FAILED', associated=False, target=target)

    address = ipv4_address(WAN)
    if not address or address.startswith('169.254.'):
        return probe_result('NO_DHCP', associated=True, address=address, target=target)

    route = route_status_for(WAN)
    if not route:
        return probe_result('NO_ROUTE', associated=True, address=address, target=target)

    http = fixed_http_probe(target)
    http_status = http.get('http_status')
    returncode = http.get('returncode')
    if returncode == 6:
        state = 'NO_DNS'
    elif returncode == 0 and http_status is not None and (200 <= http_status < 400 or http_status == 511):
        # A portal answers plain HTTP with 511 or a 3xx/200 redirect to a
        # private address (the same test portal_status() applies).
        captive = http_status == 511 or redirects_to_private_address(http.get('redirect_url'), target)
        state = 'CAPTIVE_PORTAL' if captive else 'INTERNET_OK'
    else:
        state = 'NO_INTERNET'
    return probe_result(state, associated=True, address=address, route=route,
                        http_status=http_status, duration_ms=http.get('duration_ms'), target=target)


def parse_wifi_scan(output):
    networks = []
    current = None
    for line in (output or '').splitlines():
        if line.startswith('BSS '):
            if current and current.get('ssid'):
                networks.append(current)
            current = {'ssid': None, 'signal_dbm': None, 'frequency_mhz': None, 'channel': None, 'band': None, 'security': 'open', 'auth': [], '_privacy': False}
        elif current is not None:
            stripped = line.strip()
            if stripped.lower().startswith('signal:'):
                # iw dev scan prints "Signal: -53 dBm" (capital S); iw
                # survey dumps print "Signal level:". Accept both.
                match = re.search(r'(-?\d+(?:\.\d+)?)', stripped)
                current['signal_dbm'] = float(match.group(1)) if match else None
            elif stripped.startswith('freq:'):
                match = re.search(r'(\d+)', stripped)
                if match:
                    frequency = int(match.group(1))
                    current['frequency_mhz'] = frequency
                    current['band'] = '2.4ghz' if frequency < 2500 else ('5ghz' if frequency < 5925 else '6ghz')
            elif stripped.startswith('SSID:'):
                current['ssid'] = stripped.split(':', 1)[1].strip()
            elif stripped.startswith(('RSN:', 'WPA:')):
                # Real iw output is "RSN:\t * Version: 1" (tab-indented, with
                # content on the same line), never a bare "RSN:".
                current['security'] = 'secured'
            elif stripped.startswith('capability:') and 'Privacy' in stripped:
                # Privacy with no RSN/WPA element means WEP; still secured.
                current['_privacy'] = True
            elif stripped.startswith('* Authentication suites:'):
                for suite in stripped.split(':', 1)[1].split():
                    if suite not in current['auth']:
                        current['auth'].append(suite)
    if current and current.get('ssid'):
        networks.append(current)
    for network in networks:
        if network.pop('_privacy', False):
            network['security'] = 'secured'
        frequency = network.get('frequency_mhz') or 0
        if frequency == 2484:
            network['channel'] = 14
        elif frequency >= 5925:
            # 6 GHz (Wi-Fi 6E): channel = (freq - 5950) / 5; 5955 MHz is channel 1.
            network['channel'] = max(1, (frequency - 5950) // 5)
        elif frequency >= 5000:
            network['channel'] = max(1, round((frequency - 5000) / 5))
        elif frequency >= 2400:
            network['channel'] = max(1, round((frequency - 2407) / 5))
    return sorted(networks, key=lambda item: item.get('signal_dbm') if item.get('signal_dbm') is not None else -999, reverse=True)


def wifi_scan():
    if pressure_status().get('pressured'):
        return fail('load_shed', 'Wi-Fi scan deferred while the Pi is under load')
    # A hung or busy radio must read as a failed scan, never as an empty
    # neighbourhood: check the return code and retry once before reporting.
    last_code = None
    for attempt in (1, 2):
        try:
            result = run(['/sbin/iw', 'dev', WAN, 'scan'], timeout=20)
        except Exception:
            return fail('scan_failed', 'The fixed WAN Wi-Fi scan failed')
        last_code = result.returncode
        if result.returncode == 0 and result.stdout.strip():
            return {'ok': True, 'action': 'wifi_scan', 'networks': parse_wifi_scan(result.stdout)}
        if attempt == 1:
            time.sleep(2)
    if last_code == 124:
        return fail('scan_timeout', 'The Wi-Fi radio did not answer the scan in time; try again in a few seconds.')
    if last_code:
        return fail('scan_busy', 'The Wi-Fi radio is busy or recovering; try the scan again in a few seconds.')
    return {'ok': True, 'action': 'wifi_scan', 'networks': []}


