def ula_prefix():
    """The configured AP ULA /64, or None when absent or malformed."""
    try:
        line = Path(ULA_PREFIX_FILE).read_text().splitlines()[0].strip()
    except (OSError, IndexError):
        return None
    return line if ULA_PREFIX_RE.match(line) else None


def ap_v6_gateway():
