ADGUARD_DNS_PROBE_CMD = ['/usr/bin/dig', '+short', '+time=2', '+tries=1', '@127.0.0.1', 'example.com', 'A']


def dns_responder_live():
    """AdGuard is the host's :53 responder; a real lookup through it is the
    evidence. (Cockpit runs the helper as the unprivileged login user, where
    `ss -lntup` cannot see other users' socket owners.)"""
    try:
        return bool(text(ADGUARD_DNS_PROBE_CMD, timeout=8).strip())
    except Exception:
        return False


def adguard_upstreams(config):
    """The upstream_dns entries from AdGuardHome.yaml (its own list block)."""
    match = re.search(r'^  upstream_dns:\s*\n((?:    - .*\n?)+)', config or '', re.M)
    if not match:
        return []
    return [line.strip()[2:].strip().strip("'\"") for line in match.group(1).splitlines() if line.strip()]


def adguard_dns_status():
    try:
        config = ADGUARD_CONFIG.read_text(errors='replace')
    except OSError:
        config = ''
    if not config:
        # AdGuard rewrites its yaml at 0600; Cockpit runs this helper as the
        # login user. The deploy installs a sudoers rule that allows exactly
        # this one cat, and nothing else.
        try:
            config = text(['sudo', '/bin/cat', ADGUARD_CONFIG], timeout=10)
        except Exception:
            config = ''
    upstreams = adguard_upstreams(config)
    # fallback_dns also names Unbound (127.0.0.1:5335); only an upstream_dns
    # entry decides which resolver actually answers.
    recursive = '127.0.0.1:5335' in upstreams
    wan_dns = any(not u.startswith('[/') and not u.startswith('https://')
                  and not u.startswith('127.') for u in upstreams)
    doh = any(u.startswith('https://cloudflare-dns.com/dns-query') for u in upstreams)
    split = any('100.100.100.100' in u for u in upstreams)
    nat64 = 'nat64_prefix' in config
    if split and nat64:
        upstream = 'Hotel WAN DNS + tailnet split + DNS64'
    elif split:
        upstream = 'Hotel WAN DNS + tailnet split'
    elif doh:
        upstream = 'Cloudflare DoH'
    elif wan_dns:
        upstream = 'Hotel WAN DNS (Unbound fallback)'
    elif recursive:
        upstream = 'Unbound recursive'
    else:
        upstream = None
    mode = ('tailnet-split' if split else ('cloudflare-doh' if doh else
            ('wan-dns' if wan_dns else ('recursive' if recursive else 'unknown'))))
    running = process_active('AdGuardHome')
    resolving = dns_responder_live()
    active = running and resolving
    configured = bool(config)
    # 'degraded' = AdGuard is up but a real lookup fails (typically no WAN or
    # an unreachable upstream); distinct from the service being down.
    service = 'active' if active else ('degraded' if running else 'inactive')
    return {
        'service': service,
        'resolving': resolving,
        'mode': mode,
        'stack_mode': dns_stack_mode(),
        'configured': configured,
        'upstream': upstream,
        'verified': active and configured,
        'admin_url': 'http://192.168.200.1/',
    }


# Canonical vcgencmd get_throttled bit map (Raspberry Pi firmware docs):
#   0x1 undervoltage now, 0x2 ARM capped now, 0x4 ARM limited now, 0x8 temp limit now.
#   History bits exist in two encodings: legacy low-nibble 0x10/0x20/0x40/0x80 and
#   modern high-word 0x10000/0x20000/0x40000/0x80000. Decode both; a Zero 2 W
#   brown-out on current firmware reports 0x10000+.
THROTTLE_UNDER_VOLT_NOW = 0x1
THROTTLE_ARM_CAPPED_NOW = 0x2
THROTTLE_ARM_LIMITED_NOW = 0x4
THROTTLE_TEMPERATURE_NOW = 0x8
THROTTLE_UNDER_VOLT_HISTORY = 0x10 | 0x10000
THROTTLE_ARM_CAPPED_HISTORY = 0x20 | 0x20000
THROTTLE_ARM_LIMITED_HISTORY = 0x40 | 0x40000
THROTTLE_TEMPERATURE_HISTORY = 0x80 | 0x80000
THROTTLE_FLAG_FIELDS = ('under_volt_now', 'under_volt_history', 'throttle_now',
                        'throttle_history', 'temp_throttle_now', 'temp_throttle_history')
POWER_SIGNALS = ('undervolt-now', 'undervolt-history', 'throttle-now', 'throttle-history',
                 'temperature-now', 'temperature-history', 'clean', 'unavailable')
THROTTLE_SIGNAL_FLAGS = {
    'undervolt-now': 'under_volt_now',
    'undervolt-history': 'under_volt_history',
    'throttle-now': 'throttle_now',
    'throttle-history': 'throttle_history',
    'temperature-now': 'temp_throttle_now',
    'temperature-history': 'temp_throttle_history',
}
THROTTLE_DETAILS = {
    'clean': 'No current or historical power-throttle flags.',
    'undervolt-now': 'Under-voltage is happening now — reduce load / check both power sources.',
    'undervolt-history': 'Under-voltage occurred since this boot (check the Pi Zero 2 W dual power sources).',
    'throttle-now': 'CPU throttling is active.',
    'throttle-history': 'CPU throttling is active.',
    'temperature-now': 'Temperature throttling flags are present.',
    'temperature-history': 'Temperature throttling flags are present.',
}


def decode_throttle_bits(value):
    """Decode the vcgencmd get_throttled bitmask into flags and a priority signal."""
    flags = {
        'under_volt_now': bool(value & THROTTLE_UNDER_VOLT_NOW),
        'under_volt_history': bool(value & THROTTLE_UNDER_VOLT_HISTORY),
        'throttle_now': bool(value & (THROTTLE_ARM_CAPPED_NOW | THROTTLE_ARM_LIMITED_NOW)),
        'throttle_history': bool(value & (THROTTLE_ARM_CAPPED_HISTORY | THROTTLE_ARM_LIMITED_HISTORY)),
        'temp_throttle_now': bool(value & THROTTLE_TEMPERATURE_NOW),
        'temp_throttle_history': bool(value & THROTTLE_TEMPERATURE_HISTORY),
    }
    signal = 'clean'
    for candidate, key in THROTTLE_SIGNAL_FLAGS.items():
        if flags[key]:
            signal = candidate
            break
    flags['signal'] = signal
    return flags


def parse_core_volts(output):
    match = re.search(r'volt=([0-9]+(?:\.[0-9]+)?)\s*V', output or '', re.I)
    if not match:
        return None
    try:
        return float(match.group(1))
    except ValueError:
        return None


def current_sensor_reading():
    """Read an optional INA219/INA226 hwmon sensor: name, milliamps, watts (null when absent)."""
    record = {'current_sensor': None, 'current_ma': None, 'power_w': None}
    try:
        directories = sorted(HWMON_SYS.glob('hwmon*'))
    except OSError:
        return record
    for directory in directories:
        try:
            name = (directory / 'name').read_text(errors='replace').strip().lower()
        except OSError:
            continue
        matched = next((sensor for sensor in INA_SENSORS if sensor in name), None)
        if matched is None:
            continue
        record['current_sensor'] = matched
        for field, filename, scale, digits in (('current_ma', 'in2_input', 1000.0, 1),
                                               ('power_w', 'power1_input', 1000.0, 2)):
            try:
                raw = int((directory / filename).read_text(errors='replace').strip())
            except (OSError, ValueError):
                continue
            record[field] = round(raw / scale, digits)
        break
    return record


def usb_otg_status():
    record = {'usb_otg_present': (USB_BUS_SYS / USB_OTG_ROOT).is_dir(), 'usb_devices': None,
              'usb_demand_ma': None}
    try:
        devices = [entry for entry in USB_BUS_SYS.iterdir() if USB_DEVICE_RE.match(entry.name)]
        record['usb_devices'] = len(devices)
        demand = 0
        for entry in devices:
            try:
                # Hosts report bMaxPower as bare milliamps or with an 'mA' suffix.
                digits = re.sub(r'\D', '', (entry / 'bMaxPower').read_text(errors='replace'))
            except OSError:
                continue
            if digits:
                demand += int(digits)
        record['usb_demand_ma'] = demand
    except OSError:
        pass
    return record


def power_recorder_status():
    """Read the boot power recorder log: an unexpected shutdown (crash/power-loss)
    is flagged when the latest unexpected-shutdown event post-dates the latest
    clean-shutdown marker. Null when the recorder log is absent."""
    record = {'unexpected_shutdown': None, 'power_loss_count': None}
    try:
        events = []
        for line in POWER_LOG.read_text(errors='replace').splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                events.append(json.loads(line).get('event'))
            except (ValueError, TypeError):
                continue
    except OSError:
        return record
    if events:
        last_unexpected = max((i for i, e in enumerate(events)
                               if e == 'unexpected-shutdown'), default=-1)
        last_clean = max((i for i, e in enumerate(events)
                          if e == 'clean-shutdown'), default=-1)
        record['unexpected_shutdown'] = last_unexpected > last_clean
        record['power_loss_count'] = sum(1 for e in events if e == 'unexpected-shutdown')
    return record


def clock_synced():
    """NTP sync state from timedatectl; None when unresolvable (degrade explicitly)."""
    try:
        value = text(CLOCK_SYNC_CMD).strip().lower()
    except Exception:
        return None
    if value == 'yes':
        return True
    if value == 'no':
        return False
    return None


def firmware_config_overrides():
    """Rail-demand-relevant firmware settings from config.txt (allowlisted keys only);
    None when the file is unreadable."""
    try:
        lines = FIRMWARE_CONFIG.read_text(errors='replace').splitlines()
    except OSError:
        return None
    overrides = []
    for line in lines:
        match = re.match(r'^\s*([A-Za-z0-9_]+)\s*=\s*(\S+)', line.split('#', 1)[0])
        if match and match.group(1) in FIRMWARE_DEMAND_KEYS:
            overrides.append(match.group(1) + '=' + match.group(2))
    return overrides


def journal_power_events():
    """Cached kernel-journal scan: throttle events, radio resets, filesystem errors."""
    cached = fresh_cache(JOURNAL_EVENTS_CACHE, ('events',), JOURNAL_EVENTS_TTL)
    if cached and isinstance(cached['events'], dict):
        return cached['events']
    throttle_events = 0
    radio_reset_events = 0
    radio_link_events = 0
    fs_errors = 0
    try:
        for line in text(KERNEL_JOURNAL_CMD, timeout=15).splitlines():
            if 'Throttling detected' in line:
                throttle_events += 1
            low = line.lower()
            if 'mt7921' in low or 'mt7925' in low:
                if 'reset' in low:
                    radio_reset_events += 1
                elif 'vendor request' in low and 'failed' in low:
                    radio_link_events += 1
            if 'EXT4-fs error' in line:
                fs_errors += 1
    except Exception:
        pass
    events = {'throttle_events': throttle_events,
              'radio_reset_events': radio_reset_events,
              'radio_link_events': radio_link_events,
              'fs_errors': fs_errors}
    store_cache(JOURNAL_EVENTS_CACHE, events=events)
    return events


