def sqm_autotune_status():
    """Visibility for the SQM auto-tuner: mode (auto vs dashboard-pinned),
    last measurement, and the rates it applied."""
    pinned = False
    try:
        pinned = 'TRAVELPI_SQM_AUTOTUNE=no' in Path(SQM_ENV_FILE).read_text(errors='replace')
    except OSError:
        pass
    result = {'mode': 'pinned' if pinned else 'auto', 'state': 'off'}
    try:
        data = json.loads(Path(SQM_AUTOTUNE_STATE).read_text(errors='replace'))
    except Exception:
        return result
    age = int(time.time() - (data.get('ts') or 0))
    result['age_s'] = age
    for key in ('down_mbit', 'up_mbit', 'applied_down_mbit', 'applied_up_mbit'):
        result[key] = data.get(key)
    if data.get('last_error'):
        result['state'] = 'probe-failed'
    elif not data.get('applied_down_mbit'):
        result['state'] = 'off'
    elif pinned:
        result['state'] = 'pinned'
    elif age < SQM_AUTOTUNE_FRESH:
        result['state'] = 'active'
    else:
        result['state'] = 'stale'
    return result


