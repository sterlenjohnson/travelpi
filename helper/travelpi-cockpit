def confirm(request):
    return request.get('confirm') is True


def validate_mac(value):
    value = str(value or '').lower()
    if not MAC_RE.fullmatch(value):
        raise ValueError('invalid MAC address')
    first = int(value[:2], 16)
    if first & 1 or not (first & 2):
        raise ValueError('MAC must be a unicast locally administered address')
    return value


def wifi_profiles():
    """Saved Wi-Fi profiles as {name, uuid, ssid, timestamp} (timestamp 0 = never activated)."""
    try:
        out = text(['/usr/bin/nmcli', '-t', '-f', 'NAME,UUID,TYPE', 'connection', 'show'])
    except Exception:
        return []
    profiles = []
    for line in out.splitlines():
        parts = line.rsplit(':', 2)
        if len(parts) != 3 or parts[2] != '802-11-wireless':
            continue
        name, uuid = parts[0].replace('\\:', ':'), parts[1]
        try:
            detail = text(['/usr/bin/nmcli', '-t', '-f', '802-11-wireless.ssid,connection.timestamp',
                           'connection', 'show', 'uuid', uuid])
        except Exception:
            detail = ''
        fields = {}
        for row in detail.splitlines():
            key, _, value = row.partition(':')
            fields[key.strip()] = value.strip()
        try:
            timestamp = int(fields.get('connection.timestamp') or 0)
        except ValueError:
            timestamp = 0
        profiles.append({'name': name, 'uuid': uuid,
                         'ssid': fields.get('802-11-wireless.ssid', ''), 'timestamp': timestamp})
    return profiles


WRONG_PASSWORD_HINTS = ('secrets were required', 'no secrets', '4-way', 'handshake', 'wrong password',
                        'invalid password', 'psk', 'authentication', 'password')


def classify_connect_failure(password, result):
    detail = ((result.stderr or '') + ' ' + (result.stdout or '')).lower()
    if not password and ('secrets were required' in detail or 'password' in detail):
        return 'password_required'
    if password and any(hint in detail for hint in WRONG_PASSWORD_HINTS):
        return 'wrong_password'
    return 'connect_failed'


def connect_hotel(request):
    ssid = str(request.get('ssid') or '').strip()
    password = str(request.get('password') or '')
    if not ssid or len(ssid) > 32 or '\n' in ssid or '\r' in ssid:
        return fail('invalid_ssid', 'Invalid hotel SSID')
    if len(password) > 128 or '\n' in password or '\r' in password:
        return fail('invalid_password', 'Invalid hotel password')
    hidden = request.get('hidden', False)
    if not isinstance(hidden, bool):
        return fail('invalid_hidden', 'Hidden network flag must be true or false')
    # --ask keeps the secret out of argv. NetworkManager may retain a profile
    # according to its normal policy; the UI never displays or logs it.
    previous_profile = active_profile(WAN)
    # -w bounds the wait so a bad PSK fails in about 30 s instead of ~47 s.
    argv = ['/usr/bin/nmcli', '-w', '30', '--ask', 'device', 'wifi', 'connect', ssid, 'ifname', WAN]
    if hidden:
        argv += ['hidden', 'yes']
    profiles_before = wifi_profiles()
    uuids_before = {profile['uuid'] for profile in profiles_before}

    def delete_profile(profile):
        run(['/usr/bin/nmcli', 'connection', 'delete', 'uuid', profile['uuid']], timeout=20)

    if password:
        # A profile that has never activated (timestamp 0) is leftover from a
        # failed attempt: it would reuse its stale secret and ignore this
        # password. Profiles that connected before stay authoritative.
        for profile in profiles_before:
            if profile['ssid'] == ssid and profile['timestamp'] == 0 and profile['name'] != previous_profile:
                delete_profile(profile)

    def rollback():
        # Remove profiles this attempt created, or this SSID's profiles that
        # never activated, so a bad password never persists. Profiles that
        # connected before stay authoritative. Then bring the previous WAN back.
        for profile in wifi_profiles():
            created = profile['uuid'] not in uuids_before
            stale = profile['ssid'] == ssid and profile['timestamp'] == 0
            if created or stale:
                delete_profile(profile)
        if previous_profile:
            run(['/usr/bin/nmcli', 'connection', 'up', previous_profile, 'ifname', WAN], timeout=45)

    result = run(argv, input_text=(password + '\n') if password else '\n', timeout=50)
    if result.returncode:
        rollback()
        code = classify_connect_failure(password, result)
        if code == 'password_required':
            return fail('password_required', 'That network needs a password; enter it and try again.')
        if code == 'wrong_password':
            return fail('wrong_password', 'The network rejected the password; check it and try again.')
        return fail('connect_failed', 'Hotel Wi-Fi connection failed'
                    + ('; the previous WAN was restored.' if previous_profile else '.'))
    verification = probe()
    state = verification.get('status')
    if state not in {'INTERNET_OK', 'CAPTIVE_PORTAL', 'NO_INTERNET'}:
        rollback()
        return fail('wan_probe_failed', 'Hotel Wi-Fi connected but WAN verification failed; the previous WAN was restored')
    if state == 'CAPTIVE_PORTAL':
        message = 'Connected to hotel Wi-Fi, but a captive portal is blocking internet; sign in from a device.'
    elif state == 'NO_INTERNET':
        message = 'Connected to hotel Wi-Fi, but no internet was detected yet.'
    else:
        message = 'Hotel Wi-Fi connection completed'
    return ok('connect_hotel', message, status()['status'])


WAN_VERIFIED_STATES = {'INTERNET_OK', 'CAPTIVE_PORTAL', 'NO_INTERNET'}
MAC_SETTING = '802-11-wireless.cloned-mac-address'


def apply_wan_profile_setting(profile, setting, value, previous):
    """Set one NetworkManager setting on the WAN profile, bounce the
    connection, probe-verify, and put `previous` back on any failure.

    Returns 'applied', 'applied_no_internet' (verified associated but the probe
    saw NO_INTERNET), 'update_failed' (nothing changed), 'verify_failed'
    (restored and reconnected) or 'unrestored' (the previous setting could not
    be put back or the connection did not come back)."""
    result = run(['/usr/bin/nmcli', 'connection', 'modify', profile, setting, value], timeout=30)
    if result.returncode:
        return 'update_failed'
    run(['/usr/bin/nmcli', 'connection', 'down', profile], timeout=30)
    result = run(['/usr/bin/nmcli', 'connection', 'up', profile, 'ifname', WAN], timeout=45)
    verification = probe() if result.returncode == 0 else None
    if result.returncode == 0 and verification.get('status') in WAN_VERIFIED_STATES:
        return 'applied_no_internet' if verification.get('status') == 'NO_INTERNET' else 'applied'
    restored = run(['/usr/bin/nmcli', 'connection', 'modify', profile, setting, previous], timeout=30)
    run(['/usr/bin/nmcli', 'connection', 'down', profile], timeout=30)
    reconnected = run(['/usr/bin/nmcli', 'connection', 'up', profile, 'ifname', WAN], timeout=45)
    return 'unrestored' if (restored.returncode or reconnected.returncode) else 'verify_failed'


def clone_mac(request):
    profile = active_profile(WAN)
    if not profile:
        return fail('wan_not_connected', 'No active hotel connection on wlan0')
    mode = str(request.get('mode') or 'specific')
    if mode == 'default':
        # Reset to hardware identity: clear any cloned/random MAC so the adapter
        # uses its permanent burned-in address. Restores the clone if WAN dies.
        value, saved = '', 'WAN MAC reset to the hardware default'
        codes = ('mac_update_failed', 'Could not clear the WAN MAC setting',
                 'mac_verify_failed', 'Reset to the hardware MAC broke connectivity; the previous setting was restored')
    elif mode == 'random':
        # Privacy mode: NetworkManager generates a fresh locally administered
        # MAC per connection for this profile; no fixed identity per hotel.
        value, saved = 'random', 'Hotel Wi-Fi now uses a randomized WAN MAC'
        codes = ('mac_update_failed', 'Could not save the WAN MAC setting',
                 'mac_verify_failed', 'Random WAN MAC broke connectivity; the previous setting was restored')
    else:
        try:
            value = validate_mac(request.get('mac'))
        except ValueError as error:
            return fail('invalid_mac', str(error))
        saved = 'WAN MAC clone applied'
        codes = ('mac_update_failed', 'Could not save the WAN MAC clone',
                 'wan_reconnect_failed', 'WAN verification failed; the previous MAC identity was restored')
    try:
        current = run(['/usr/bin/nmcli', '-g', MAC_SETTING, 'connection', 'show', profile])
    except Exception:
        current = None
    if current is None or current.returncode:
        # A failed read must not be mistaken for an empty (default) setting:
        # that would "restore" the wrong identity if the change fails.
        return fail('mac_update_failed', 'Could not read the current WAN MAC setting; nothing changed.')
    previous = current.stdout.strip().replace('\\:', ':')
    outcome = apply_wan_profile_setting(profile, MAC_SETTING, value, previous)
    if outcome == 'update_failed':
        return fail(codes[0], codes[1])
    if outcome == 'verify_failed':
        return fail(codes[2], codes[3])
    if outcome == 'unrestored':
        return fail(codes[2] + '_unrestored',
                    'The WAN identity change failed and the previous setting could not be brought back; '
                    'reconnect from the Hotel page.')
    if outcome == 'applied_no_internet':
        saved += ', but no internet was detected'
    return ok('apply_mac_clone', saved, status()['status'])


NM_BAND_VALUES = {'2.4ghz': 'bg', '5ghz': 'a', 'auto': ''}
NM_BAND_NAMES = {'bg': '2.4ghz', 'a': '5ghz'}


def wan_band_setting(profile):
    """The NetworkManager band selector on the WAN profile: auto, 2.4ghz or
    5ghz; None when it cannot be read."""
    try:
        value = text(['/usr/bin/nmcli', '-g', '802-11-wireless.band',
                      'connection', 'show', profile]).strip()
    except Exception:
        return None
    return NM_BAND_NAMES.get(value, 'auto' if not value else None)


def set_wan_band(request):
    """Pin the WAN association to one band via the active profile's
    802-11-wireless.band (no secrets touched), then reactivate, verify with
    the WAN probe and restore the previous setting on any failure."""
    band = request.get('band')
    if band not in ('auto', '2.4ghz', '5ghz', '6ghz'):
        return fail('invalid_wan_band', 'Unsupported WAN band')
    if band != 'auto':
        reported = radio_phy_capabilities(WAN).get('bands') or []
        if band not in reported:
            return fail('band_unsupported',
                        'The WAN radio has not reported ' + band + ' support; nothing changed.')
        if band == '6ghz':
            return fail('radio_capability_missing',
                        'NetworkManager has no 6 GHz band selector, so the WAN band cannot be pinned to 6 GHz; nothing changed.')
    profile = active_profile(WAN)
    if not profile:
        return fail('wan_not_connected', 'No active hotel connection on wlan0')
    try:
        previous = text(['/usr/bin/nmcli', '-g', '802-11-wireless.band',
                         'connection', 'show', profile]).strip()
    except Exception:
        return fail('wan_band_failed', 'Could not read the current WAN band setting; nothing changed.')
    outcome = apply_wan_profile_setting(profile, '802-11-wireless.band', NM_BAND_VALUES[band], previous)
    if outcome == 'update_failed':
        return fail('wan_band_failed', 'Could not save the WAN band setting; nothing changed.')
    if outcome == 'unrestored':
        return fail('wan_band_failed_unrestored',
                    'The WAN band change failed and the previous connection could not be brought back; reconnect from the Hotel page.')
    if outcome == 'verify_failed':
        return fail('wan_band_failed', 'WAN verification failed on the requested band; the previous band setting was restored')
    message = 'WAN band set to ' + ('automatic' if band == 'auto' else band)
    if outcome == 'applied_no_internet':
        message += ', but no internet was detected'
    return ok('set_wan_band', message, status()['status'])


def replace_setting(lines, key, value):
    pattern = re.compile(r'^' + re.escape(key) + r'=')
    for index, line in enumerate(lines):
        if pattern.match(line):
            lines[index] = key + '=' + value
            return lines
    lines.append(key + '=' + value)
    return lines


def radio_phy_capabilities(interface):
    """Live capability read for one radio from iw phy info; empty shapes when
    the read fails (callers then refuse rather than guess)."""
    try:
        phy_name = (DEVICE_SYS / interface / 'phy80211' / 'name').read_text().strip()
        iw_info = text(['/sbin/iw', 'phy', phy_name, 'info']) if phy_name else ''
        return parse_radio_capabilities(iw_info)
    except Exception:
        return {'bands': [], 'capabilities': [], 'supported_channels': {}}


def ap_phy_capabilities():
    """Live capability read for the AP radio from iw phy info; empty shapes
    when the read fails (the helper then refuses channel picks rather than
    guessing, per the honest-unavailable rule). Profiles the canonical AP
    radio (wlan1); the arbitrary role swap stays gated (ADR-0002/0004),
    so this is the radio set_ap_radio can move."""
    return radio_phy_capabilities(LAN)


def hostapd_backup_path():
    return HOSTAPD.with_suffix('.conf.travelpi-backup')


def write_hostapd_config(content):
    """hostapd.conf carries the AP WPA passphrase: write it atomically,
    root-only (0600), regardless of the mode the previous file had."""
    write_private_file(HOSTAPD, content, 0o600)


def backup_hostapd_config():
    """Snapshot the current hostapd.conf (old passphrase included) at 0600.
    The copy exists only while a change is in flight."""
    write_private_file(hostapd_backup_path(), HOSTAPD.read_text(), 0o600)


def restore_hostapd_config():
    """Put the backup back through the private writer so the restored file is
    0600. Leaves the backup in place; the caller discards it once the whole
    rollback has succeeded. Raises on failure."""
    write_hostapd_config(hostapd_backup_path().read_text())


def discard_hostapd_backup():
    """Remove the backup so a previous passphrase does not linger."""
    try:
        hostapd_backup_path().unlink()
    except FileNotFoundError:
        pass
    except OSError:
        pass  # the change already applied or rolled back; not a failure


def apply_hostapd_change(lines):
    """Write new hostapd.conf lines and restart hostapd, restoring the previous
    config on any failure after the rewrite. Returns None on success,
    'failed' (nothing was rewritten), 'restart' (rolled back) or
    'unrestored' (restore failed; the 0600 backup stays). Never raises."""
    written = False
    failed = False
    try:
        backup_hostapd_config()
        write_hostapd_config('\n'.join(lines) + '\n')
        written = True
        failed = bool(run(['/bin/systemctl', 'restart', 'hostapd'], timeout=30).returncode)
    except Exception:
        failed = True
    if not failed:
        discard_hostapd_backup()
        return None
    if not written:
        discard_hostapd_backup()
        return 'failed'
    try:
        restore_hostapd_config()
        run(['/bin/systemctl', 'restart', 'hostapd'], timeout=30)
    except Exception:
        return 'unrestored'
    discard_hostapd_backup()
    return 'restart'


def ap_profile(request):
    profile = request.get('band')
    if profile not in ('2.4ghz', '5ghz', '6ghz'):
        return fail('invalid_ap_profile', 'Unsupported AP profile')
    requested = request.get('channel')
    caps = ap_phy_capabilities()
    allowed = (caps.get('supported_channels') or {}).get(profile) or []
    if profile == '6ghz' and not allowed:
        return fail('radio_capability_missing',
                    'The AP radio has not reported 6 GHz support; nothing changed.')
    if requested is not None:
        if not allowed:
            return fail('radio_capability_missing',
                        'The AP radio has not reported supported channels; leave the channel on Default.')
        try:
            channel = int(requested)
        except (TypeError, ValueError):
            return fail('invalid_ap_channel', 'AP channel must be a number')
        if channel not in allowed:
            return fail('invalid_ap_channel',
                        'Channel ' + str(channel) + ' is not available on the AP radio'
                        + (' (available: ' + ', '.join(str(c) for c in allowed) + ')' if allowed else '')
                        + '; it is radar (DFS)-excluded or unsupported by the hardware.')
    elif profile == '2.4ghz':
        channel = 6
    elif profile == '5ghz':
        channel = 36
    else:
        channel = min(allowed)
    try:
        lines = HOSTAPD.read_text().splitlines()
    except Exception:
        return fail('hostapd_config_missing', 'hostapd configuration is unavailable')
    lines = replace_setting(lines, 'hw_mode', 'g' if profile == '2.4ghz' else 'a')
    lines = replace_setting(lines, 'channel', str(channel))
    lines = replace_setting(lines, 'ieee80211n', '1')
    lines = replace_setting(lines, 'wmm_enabled', '1')
    lines = replace_setting(lines, 'ieee80211ac', '1' if profile == '5ghz' else '0')
    lines = replace_setting(lines, 'ieee80211ax', '1' if profile in ('5ghz', '6ghz') else '0')
    lines = replace_setting(lines, 'he_6ghz', '1' if profile == '6ghz' else '0')
    # 6 GHz bands require management frame protection; hostapd refuses the
    # band without ieee80211w=2. Other bands stay at 1 (supported, optional),
    # which is hostapd's default behavior for WPA2-PSK.
    lines = replace_setting(lines, 'ieee80211w', '2' if profile == '6ghz' else '1')
    outcome = apply_hostapd_change(lines)
    if outcome == 'failed':
        return fail('ap_update_failed', 'Could not update the AP profile')
    if outcome == 'unrestored':
        return fail('ap_restart_failed_unrestored',
                    'AP profile failed to apply and the previous hostapd configuration could not be '
                    'restored. Repair the radios or restore ' + str(hostapd_backup_path()) + ' before relying on the AP.')
    if outcome == 'restart':
        return fail('ap_restart_failed', 'AP profile was not verified; the previous profile was restored')
    return ok('set_ap_radio', 'TravelPi AP profile applied')


def set_ap_identity(request):
    """Change the AP broadcast name and/or WPA password (WPA2-PSK stays the
    only mode). The passphrase arrives via stdin JSON (never argv) and never
    appears in any response, status payload, or log. hostapd requires it in
    its config, so it is written there (and only there) atomically with mode
    0600, root-only. A 0600 hostapd.conf.travelpi-backup of the previous
    config (old passphrase) exists only while the change is in flight: it is
    removed once hostapd restarts. If the restart fails, or anything fails
    after the rewrite, the previous config is restored at 0600 and the backup
    removed; if the restore itself fails the 0600 backup is kept and
    ap_identity_failed_unrestored names it. The dashboard stores nothing."""
    ssid = request.get('ssid')
    passphrase = request.get('passphrase')
    if ssid is None and passphrase is None:
        return fail('invalid_ap_identity', 'Provide a new AP name, a new password, or both')
    if ssid is not None:
        if not isinstance(ssid, str) or not (1 <= len(ssid.encode('utf-8')) <= 32) or re.search(r'[\x00-\x1f\x7f]', ssid):
            return fail('invalid_ap_identity', 'AP name must be 1-32 bytes of printable characters')
        if ssid != ssid.lstrip(' \t'):
            return fail('invalid_ap_identity', 'AP name must not start with a space (hostapd strips it)')
    if passphrase is not None:
        if not isinstance(passphrase, str) or not passphrase.isascii() or not (8 <= len(passphrase) <= 63) or re.search(r'[\x00-\x1f\x7f]', passphrase):
            return fail('invalid_ap_identity', 'AP password must be 8-63 printable ASCII characters')
        # hostapd strips leading whitespace from wpa_passphrase and treats a
        # leading double quote as a C-style quoted value; refuse the inputs
        # whose effective secret would differ from what was typed.
        if passphrase != passphrase.strip() or passphrase.startswith('"'):
            return fail('invalid_ap_identity',
                        'AP password must not start with a quote or carry leading/trailing spaces')
    try:
        lines = HOSTAPD.read_text().splitlines()
    except Exception:
        return fail('hostapd_config_missing', 'hostapd configuration is unavailable')
    if ssid is not None:
        lines = replace_setting(lines, 'ssid', ssid)
    if passphrase is not None:
        lines = replace_setting(lines, 'wpa_passphrase', passphrase)
        lines = replace_setting(lines, 'wpa', '2')
        lines = replace_setting(lines, 'wpa_key_mgmt', 'WPA-PSK')
    outcome = apply_hostapd_change(lines)
    if outcome == 'failed':
        return fail('ap_identity_failed', 'Could not update the AP identity')
    if outcome == 'unrestored':
        return fail('ap_identity_failed_unrestored',
                    'The AP did not come up with the new identity and the previous hostapd configuration '
                    'could not be restored. Restore ' + str(hostapd_backup_path()) + ' before relying on the AP.')
    if outcome == 'restart':
        return fail('ap_identity_failed',
                    'The AP did not come up with the new identity; the previous configuration was restored')
    return ok('set_ap_identity', 'AP identity updated')


def set_conf_interface_setting(lines, new_iface):
    out = []
    found = False
    for line in lines:
        if line.startswith('interface='):
            out.append('interface=' + new_iface)
            found = True
        else:
            out.append(line)
    if not found:
        out.append('interface=' + new_iface)
    return out


def wifi_radio_interfaces():
    radios = []
    try:
        out = text(['/usr/bin/nmcli', '-t', '-f', 'DEVICE,TYPE', 'device', 'status'])
    except Exception:
        return radios
    for line in out.splitlines():
        parts = line.split(':', 1)
        if len(parts) == 2 and parts[1] == 'wifi':
            radios.append(parts[0])
    return radios


def find_wan_connection(ap_iface):
    wan_radio = None
    for r in wifi_radio_interfaces():
        if r and r != ap_iface:
            wan_radio = r
            break
    if not wan_radio:
        return None
    candidates = []
    try:
        out = text(['/usr/bin/nmcli', '-t', '-f', 'NAME,TYPE', 'connection', 'show'])
        for line in out.splitlines():
            parts = split_terse(line)
            if len(parts) == 2 and parts[1] == '802-11-wireless':
                candidates.append(parts[0])
    except Exception:
        return None
    if not candidates:
        return None
    for name in candidates:
        try:
            bound = text(['/usr/bin/nmcli', '-g', 'connection.interface-name',
                          'connection', 'show', name]).strip()
        except Exception:
            bound = ''
        if bound == wan_radio:
            return name
    for name in candidates:
        try:
            bound = text(['/usr/bin/nmcli', '-g', 'connection.interface-name',
                          'connection', 'show', name]).strip()
        except Exception:
            bound = ''
        if bound == ap_iface:
            return name
    try:
        out = text(['/usr/bin/nmcli', '-t', '-f', 'NAME,DEVICE,TYPE', 'connection', 'show', '--active'])
        for line in out.splitlines():
            parts = split_terse(line)
            if len(parts) == 3 and parts[2] == '802-11-wireless' and parts[1]:
                return parts[0]
    except Exception:
        pass
    return None


def down_all_wifi_stations():
    try:
        out = text(['/usr/bin/nmcli', '-t', '-f', 'NAME,TYPE', 'connection', 'show', '--active'])
    except Exception:
        return
    for line in out.splitlines():
        parts = split_terse(line)
        if len(parts) == 2 and parts[1] == '802-11-wireless':
            run(['/usr/bin/nmcli', 'connection', 'down', parts[0]], timeout=20)


def ensure_wan_spoof(wan_conn):
    if not wan_conn:
        return
    # A failed read is not "unset": leave a real clone alone rather than
    # overwrite it with a random one.
    try:
        result = run(['/usr/bin/nmcli', '-g', '802-11-wireless.cloned-mac-address',
                      'connection', 'show', wan_conn])
    except Exception:
        return
    if result.returncode != 0:
        return
    current = (result.stdout or '').strip()
    if not current or current.lower() in ('permanent', 'preserve'):
        run(['/usr/bin/nmcli', 'connection', 'modify', wan_conn,
             '802-11-wireless.cloned-mac-address', 'random'])


def apply_radio_layout(ap_iface, wan_iface, ap_hw_mode, ap_channel, ap_ac, ap_ax):
    try:
        current = HOSTAPD.read_text().splitlines()
    except Exception:
        return fail('hostapd_config_missing', 'hostapd configuration is unavailable')
    try:
        dnsmasq_path = DNSMASQ_CONF
        dnsmasq_lines = set_conf_interface_setting(dnsmasq_path.read_text().splitlines(), ap_iface)
    except Exception:
        return fail('dnsmasq_config_missing', 'dnsmasq configuration is unavailable')
    new_lines = set_conf_interface_setting(current, ap_iface)
    new_lines = replace_setting(new_lines, 'hw_mode', ap_hw_mode)
    new_lines = replace_setting(new_lines, 'channel', ap_channel)
    new_lines = replace_setting(new_lines, 'ieee80211ac', ap_ac)
    new_lines = replace_setting(new_lines, 'ieee80211ax', ap_ax)
    backup = hostapd_backup_path()
    dnsmasq_backup = dnsmasq_path.with_suffix('.conf.travelpi-backup')
    written = False
    try:
        backup_hostapd_config()
        shutil.copy2(dnsmasq_path, dnsmasq_backup)
        write_hostapd_config(chr(10).join(new_lines) + chr(10))
        written = True
        dnsmasq_path.write_text(chr(10).join(dnsmasq_lines) + chr(10))
    except Exception:
        if written:
            try:
                restore_hostapd_config()
            except Exception:
                return fail('radio_config_failed',
                            'Could not rewrite interface configuration and the previous hostapd configuration '
                            'could not be restored. Restore ' + str(backup) + ' before relying on the AP.')
        discard_hostapd_backup()
        return fail('radio_config_failed', 'Could not rewrite interface configuration')

    try:
        # Tear down any AP and Wi-Fi stations so one radio is never both AP and STA,
        # and the cloned WAN MAC cannot appear on two interfaces at once.
        run(['/bin/systemctl', 'stop', 'hostapd'], timeout=20)
        run(['/bin/systemctl', 'stop', 'dnsmasq'], timeout=20)
        down_all_wifi_stations()

        # Hand the AP radio to hostapd/dnsmasq and assign the AP address.
        # IPv4-scoped flush: a family-blind flush wipes the IPv6 link-local
        # address, and radvd must advertise from a link-local source (2026-10-30
        # ULA incident; see ensure_ipv6_link_local).
        run(['/usr/bin/nmcli', 'device', 'set', ap_iface, 'managed', 'no'], timeout=20)
        run(['/sbin/ip', 'link', 'set', ap_iface, 'up'], timeout=20)
        run(['/sbin/ip', '-4', 'addr', 'flush', 'dev', ap_iface], timeout=20)
        run(['/sbin/ip', 'addr', 'add', AP_ADDRESS, 'dev', ap_iface], timeout=20)
        ensure_ipv6_link_local(ap_iface)
        gateway = ap_v6_gateway()
        if gateway:
            run(['/sbin/ip', '-6', 'addr', 'add', gateway, 'dev', ap_iface], timeout=20)

        # Turn the WAN radio OFF during the transition to avoid a cloned-MAC spoof split.
        run(['/usr/bin/nmcli', 'device', 'set', wan_iface, 'managed', 'yes'], timeout=20)
        run(['/sbin/ip', 'link', 'set', wan_iface, 'down'], timeout=20)

        run(['/bin/systemctl', 'restart', 'hostapd'], timeout=30)
        run(['/bin/systemctl', 'restart', 'dnsmasq'], timeout=30)
        # radvd binds its interface and source address at startup; restart it so
        # the freshly assigned link-local/gateway addresses take effect.
        run(['/bin/systemctl', 'restart', 'systemd-networkd'], timeout=20)
        time.sleep(3)
        failed = run(['/bin/systemctl', 'is-active', 'hostapd']).returncode != 0
    except Exception:
        failed = True
    if failed:
        restored = True
        try:
            # Restore both interface owners: leaving dnsmasq on the new radio
            # while hostapd returns to the old one splits the AP in half.
            restore_hostapd_config()
            shutil.copy2(dnsmasq_backup, dnsmasq_path)
            run(['/bin/systemctl', 'restart', 'hostapd'], timeout=30)
            run(['/bin/systemctl', 'restart', 'dnsmasq'], timeout=30)
            run(['/bin/systemctl', 'restart', 'systemd-networkd'], timeout=20)
            # The abandoned AP interface returns to WAN duty; drop the
            # gateway addresses it was given during the failed flip so the
            # keeper (which follows hostapd.conf) never has to chase them.
            run(['/sbin/ip', '-4', 'addr', 'flush', 'dev', ap_iface], timeout=20)
            run(['/sbin/ip', '-6', 'addr', 'flush', 'dev', ap_iface], timeout=20)
        except Exception:
            restored = False
        if not restored:
            return fail('ap_restart_failed_unrestored',
                        'The AP did not come up on the new radio and the previous hostapd/dnsmasq configuration '
                        'could not be restored. Repair the radios or restore ' + str(backup) + ' and ' +
                        str(dnsmasq_backup) + ' before relying on the AP.')
        discard_hostapd_backup()
        return fail('ap_restart_failed', 'The AP did not come up on the new radio; the previous configuration was restored')
    discard_hostapd_backup()
    return None


def wan_flip(request):
    # CONTEXT.md: a safe role swap needs a verified LAN uplink and rollback
    # testing. Until readiness proves that, refuse honestly instead of
    # executing a swap the host has not demonstrated it can survive.
    role_switch = readiness_status()['role_switch']
    if not role_switch['available']:
        return fail('unavailable', role_switch['reason'])
    try:
        ap_iface = None
        for line in HOSTAPD.read_text().splitlines():
            if line.startswith('interface='):
                ap_iface = line.split('=', 1)[1].strip()
                break
    except Exception:
        return fail('hostapd_config_missing', 'hostapd configuration is unavailable')
    if not ap_iface:
        return fail('wan_flip_failed', 'Could not determine the current AP interface')
    radios = [r for r in wifi_radio_interfaces() if r and r != ap_iface]
    if not radios:
        return fail('wan_flip_failed', 'A radio role swap needs two or more Wi-Fi radios')
    new_ap = radios[0]
    new_wan = ap_iface
    bands = interface_hardware(new_ap).get('bands') or []
    if '5ghz' in bands:
        ap_hw_mode, ap_channel, ap_ac, ap_ax = 'a', '36', '1', '1'
    else:
        ap_hw_mode, ap_channel, ap_ac, ap_ax = 'g', '6', '0', '0'
    err = apply_radio_layout(new_ap, new_wan, ap_hw_mode, ap_channel, ap_ac, ap_ax)
    if err:
        return err
    wan_conn = find_wan_connection(new_ap)
    if wan_conn:
        ensure_wan_spoof(wan_conn)
        run(['/usr/bin/nmcli', 'connection', 'modify', wan_conn, 'connection.interface-name', new_wan])
        run(['/usr/bin/nmcli', 'connection', 'up', wan_conn, 'ifname', new_wan], timeout=40)
    return ok('wan_flip', 'Radio roles swapped: AP on ' + new_ap + ', WAN on ' + new_wan, status()['status'])


def parse_rate(value):
    match = RATE_RE.fullmatch(str(value or '').strip())
    if not match:
        raise ValueError('invalid CAKE rate')
    number = float(match.group(1))
    unit = (match.group(2) or 'mbit').lower()
    factor = {'kbit': 1, 'kbps': 1, 'mbit': 1000, 'mbps': 1000,
              'gbit': 1000000, 'gbps': 1000000}[unit]
    rate = int(number * factor)
    if rate < 100 or rate > 1000000:
        raise ValueError('CAKE rate must be between 0.1 and 1000 Mbps')
    return rate, str(rate) + 'kbit'


def sqm_environment(rate):
    # Manual pin: an explicit rate from the dashboard disables the auto-tuner.
    return 'TRAVELPI_SQM_RATE=' + str(rate) + '\nTRAVELPI_SQM_AUTOTUNE=no\n'


def write_private_file(path, content, mode=0o600):
    """Write a file atomically without following a pre-planted symlink.

    The helper runs as root, and several of these paths live in /tmp where any
    local user can plant a symlink. mkstemp + os.replace creates a fresh file
    and renames it into place, so a planted link is replaced rather than
    written through. Raises on failure: callers must report what they could
    not persist instead of claiming success.
    """
    target = str(path)
    directory = os.path.dirname(target) or '.'
    fd, temporary = tempfile.mkstemp(prefix='.travelpi-', dir=directory, text=True)
    try:
        with os.fdopen(fd, 'w') as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, target)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def read_private_cache(path, required_keys):
    """Parsed dict from a /tmp cache file, or None unless the file is
    trustworthy: a regular file (never a symlink), owned by root or by this
    process's own euid (root whenever the helper is privileged), mode exactly
    0600, JSON object carrying every required key. Anything else is ignored
    and the caller recomputes, so a planted or corrupted /tmp file cannot feed
    the dashboard."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid not in (0, os.geteuid())
                or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > 1048576):
            return None
        with os.fdopen(fd, 'r', errors='replace') as handle:
            fd = None
            data = json.load(handle)
    except (OSError, ValueError):
        return None
    finally:
        if fd is not None:
            os.close(fd)
    if not isinstance(data, dict) or any(key not in data for key in required_keys):
        return None
    return data


def fresh_cache(path, required_keys, ttl):
    """The cache's payload while younger than ttl seconds on the monotonic
    clock (this board has no RTC; wall time jumps at boot and at NTP sync), or
    None. A future stamp (stale file from another boot) counts as expired."""
    cached = read_private_cache(path, ('_cached_at',) + tuple(required_keys))
    stamp = cached.get('_cached_at') if cached else None
    if isinstance(stamp, bool) or not isinstance(stamp, (int, float)):
        return None
    return cached if 0 <= time.monotonic() - stamp <= ttl else None


def store_cache(path, **fields):
    try:
        write_private_file(path, json.dumps({'_cached_at': time.monotonic(), **fields}), 0o600)
    except Exception:
        pass


def heartbeat_state(path, ttl):
    """absent / armed / stale from a shell-touched heartbeat file's mtime.
    Wall-clock mtimes can sit in the future after a clock step back; a
    negative age is clamped to 0 (fresh) rather than flipping the status."""
    try:
        age = max(0.0, time.time() - os.path.getmtime(path))
    except OSError:
        return 'absent'
    return 'armed' if age < ttl else 'stale'


def persist_sqm_rate(rate):
    write_private_file(SQM_ENV_FILE, sqm_environment(rate), 0o644)


def cake_rate(request):
    try:
        value = request.get('rate_kbit')
        if isinstance(value, bool) or not re.fullmatch(r'[0-9]+', str(value or '')):
            raise ValueError('CAKE rate must be an integer in kbit/s')
        rate_kbit = int(value)
        if rate_kbit < 100 or rate_kbit > 1000000:
            raise ValueError('CAKE rate must be between 100 and 1000000 kbit/s')
        rate = str(rate_kbit) + 'kbit'
    except ValueError as error:
        return fail('invalid_cake_rate', str(error))

    # Keep the previous working rate available. Restarting the oneshot SQM
    # unit briefly removes qdiscs; never report success unless the route and
    # CAKE qdisc are healthy again, and attempt to restore the old rate if not.
    # The unit reads TRAVELPI_SQM_RATE from EnvironmentFile, and an
    # EnvironmentFile overrides anything set with `systemctl set-environment`,
    # so the file must be written *before* the restart or the old rate applies.
    # Snapshot the whole env file (it also carries TRAVELPI_SQM_AUTOTUNE and
    # anything else in it) so a failed apply restores it byte for byte instead
    # of rewriting it from a rate alone. None means the file did not exist.
    try:
        previous_env = Path(SQM_ENV_FILE).read_text()
    except FileNotFoundError:
        previous_env = None
    except OSError:
        return fail('cake_persist_failed', 'The current SQM settings could not be read; nothing was changed')
    try:
        persist_sqm_rate(rate)
    except Exception:
        return fail('cake_persist_failed', 'CAKE rate could not be saved; nothing was changed')
    result = run(['/bin/systemctl', 'restart', SQM_SERVICE], timeout=30)
    current = status()['status'] if result.returncode == 0 else None
    healthy = bool(current and current.get('defaultRoute', {}).get('interface') == WAN and
                   current.get('cake', {}).get('state') == 'active' and
                   service_state(SQM_SERVICE) == 'active')

    if not healthy:
        # Put the previous env file back (or remove the one we created), then
        # restart so the previous rate applies again. A new rate never stays
        # persisted after a failed apply, even when CAKE was inactive before.
        try:
            if previous_env is None:
                Path(SQM_ENV_FILE).unlink(missing_ok=True)
            else:
                write_private_file(SQM_ENV_FILE, previous_env, 0o644)
        except OSError:
            return fail('cake_restart_failed_unrestored',
                        'CAKE was not verified after restart and the previous SQM settings could not be restored; '
                        'check ' + SQM_ENV_FILE + '.')
        run(['/bin/systemctl', 'restart', SQM_SERVICE], timeout=30)
        return fail('cake_restart_failed', 'CAKE was not verified after restart; previous settings were restored')
    applied = (current or {}).get('cake', {}).get('rate')
    try:
        applied_kbit = parse_rate(applied)[0] if applied else None
    except ValueError:
        applied_kbit = None
    if applied_kbit is None or int(applied_kbit) != rate_kbit:
        # The qdisc is healthy but not at the requested rate: say which is true.
        return ok('set_cake_rate', 'CAKE is active at ' + str(applied or 'an unknown rate') +
                  '; the requested ' + str(rate_kbit) + ' kbit/s is saved for the next CAKE restart.', current)
    return ok('set_cake_rate', 'CAKE rate set to ' + str(rate_kbit) + ' kbit/s', current)


def vpn_toggle(request):
    provider = str(request.get('provider') or '')
    enabled = request.get('enabled')
    if provider not in VPN_UNITS or not isinstance(enabled, bool):
        return fail('invalid_vpn_request', 'Unsupported VPN provider or state')
    unit = VPN_UNITS[provider]
    verb = ['enable', '--now'] if enabled else ['disable', '--now']
    result = run(['/bin/systemctl', *verb, unit], timeout=30)
    if result.returncode:
        return fail('vpn_toggle_failed', provider.title() + ' could not be changed')
    return ok('vpn_toggle', provider.title() + (' enabled' if enabled else ' disabled'), status()['status'])


def tailscale_auth(request):
    authkey = str(request.get('authkey') or '').strip()
    try:
        if os.path.exists(TAILSCALE_STATUS_CACHE):
            os.remove(TAILSCALE_STATUS_CACHE)
    except OSError:
        pass
    if not authkey:
        return fail('authkey_required', 'Provide a Tailscale auth key; nothing was changed.')
    if re.search(r'[\x00-\x20\x7f]', authkey) or len(authkey) > 256:
        return fail('invalid_authkey', 'Tailscale auth key has invalid characters; nothing was changed.')
    # The key goes through a 0600 file, never argv (argv is world-readable in /proc).
    fd, key_path = tempfile.mkstemp(prefix='travelpi-ts-', dir='/run' if os.path.isdir('/run') else None)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'w') as handle:
            handle.write(authkey + '\n')
        result = run(['/usr/bin/tailscale', 'login', '--auth-key=file:' + key_path], timeout=60)
    finally:
        try:
            os.remove(key_path)
        except OSError:
            pass
    if result.returncode:
        return fail('tailscale_auth_failed', 'Tailscale authentication could not be started')
    return ok('tailscale_auth', 'Tailscale authentication requested', status()['status'])


def restart_services(request):
    targets = request.get('targets')
    if not isinstance(targets, list) or not targets or any(not isinstance(target, str) or target not in {'ap', 'sqm'} for target in targets):
        return fail('invalid_targets', 'Only the ap and sqm services may be restarted')
    for target in targets:
        unit = 'hostapd' if target == 'ap' else SQM_SERVICE
        result = run(['/bin/systemctl', 'restart', unit], timeout=30)
        if result.returncode:
            return fail('restart_failed', target.upper() + ' restart failed')
    return ok('restart_services', 'Requested services restarted')


def reset_radios(request):
    radios = wifi_radio_interfaces()
    if len(radios) < 2:
        return fail('reset_radios_failed', 'Two or more Wi-Fi radios are required')
    ap_iface = None
    for r in radios:
        bands = interface_hardware(r).get('bands') or []
        if '5ghz' in bands and not ap_iface:
            ap_iface = r
    if not ap_iface:
        ap_iface = radios[0]
    wan_iface = None
    for r in radios:
        if r != ap_iface:
            wan_iface = r
            break
    if not wan_iface:
        return fail('reset_radios_failed', 'Could not choose a WAN radio')
    bands = interface_hardware(ap_iface).get('bands') or []
    if '5ghz' in bands:
        ap_hw_mode, ap_channel, ap_ac, ap_ax = 'a', '36', '1', '1'
    else:
        ap_hw_mode, ap_channel, ap_ac, ap_ax = 'g', '6', '0', '0'
    err = apply_radio_layout(ap_iface, wan_iface, ap_hw_mode, ap_channel, ap_ac, ap_ax)
    if err:
        return err
    wan_conn = find_wan_connection(ap_iface)
    if wan_conn:
        ensure_wan_spoof(wan_conn)
        run(['/usr/bin/nmcli', 'connection', 'modify', wan_conn, 'connection.interface-name', wan_iface])
        run(['/usr/bin/nmcli', 'connection', 'up', wan_conn, 'ifname', wan_iface], timeout=40)
    return ok('reset_radios', 'Radios repaired: AP on ' + ap_iface + ', WAN on ' + wan_iface, status()['status'])


def wake_peer(request):
    """Wake-on-LAN through the tailnet: Tailscale magic packet to a peer.
    Target is a peer name or tailnet address, allowlisted to those shapes."""
    target = str(request.get('target', ''))
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9.-]{0,63}', target):
        return fail('invalid_target', 'Wake target must be a tailnet peer name or address')
    result = run(['/usr/bin/tailscale', 'wakeonlan', target], timeout=30)
    if result.returncode != 0:
        return fail('wake_failed', 'Magic packet refused by Tailscale (is the peer a tailnet node?)')
    return ok('wake_peer', 'Magic packet sent to ' + target)


DNS_MODE_FILE = '/etc/default/travelpi-dns'
UNBOUND_FRONT_CONF = '/etc/unbound/unbound.conf.d/travelpi-front.conf'
CPU_GOVERNORS = ('conservative', 'ondemand', 'performance')


def dns_stack_mode():
    try:
        line = Path(DNS_MODE_FILE).read_text(errors='replace')
        match = re.search(r'TRAVELPI_DNS_MODE=(\w+)', line)
        if match and match.group(1) in ('adguard', 'unbound'):
            return match.group(1)
    except OSError:
        pass
    return 'adguard'


def usable_upstream(value):
    """True for a routable IPv4 nameserver: not loopback (our own stub or
    Unbound), not the tailnet resolver, not IPv6."""
    try:
        address = ipaddress.ip_address(str(value).strip())
    except ValueError:
        return False
    return (address.version == 4 and not address.is_loopback and not address.is_unspecified
            and str(address) != '100.100.100.100')


def wan_nameservers():
    """Hotel DHCP nameservers: prefer NetworkManager's IP4.DNS for the WAN,
    then /etc/resolv.conf, filtered so we never forward to ourselves."""
    found = []
    try:
        out = text(['/usr/bin/nmcli', '-t', '-f', 'IP4.DNS', 'device', 'show', WAN])
        for line in out.splitlines():
            if line.startswith('IP4.DNS') and ':' in line:
                found.append(line.split(':', 1)[1].strip())
    except Exception:
        found = []
    if not any(usable_upstream(item) for item in found):
        try:
            resolv = Path('/etc/resolv.conf').read_text(errors='replace')
            found = [line.split()[1] for line in resolv.splitlines()
                     if line.startswith('nameserver ') and len(line.split()) > 1]
        except OSError:
            found = []
    result = []
    for item in found:
        if usable_upstream(item) and item not in result:
            result.append(item)
    return result[:3]


def set_dns_stack(request):
    """Toggle the DNS front door: AdGuard filtering (Unbound as fallback on
    5335) versus plain recursive Unbound on :53 with the hotel nameservers."""
    service = str(request.get('service') or '')
    if service not in ('adguard', 'unbound'):
        return fail('invalid_service', 'DNS stack must be adguard or unbound')
    upstream = str(request.get('upstream') or '')
    ns_list = []
    for item in upstream.replace(',', ' ').split():
        if not re.fullmatch(r'\d{1,3}(\.\d{1,3}){3}', item):
            return fail('invalid_upstream', 'Upstream nameserver must be an IPv4 address')
        ns_list.append(item)
    if not ns_list:
        ns_list = wan_nameservers()

    def write_mode(mode):
        try:
            write_private_file(DNS_MODE_FILE, 'TRAVELPI_DNS_MODE=' + mode + '\n', 0o644)
            return True
        except OSError:
            return False

    if service == 'adguard':
        try:
            Path(UNBOUND_FRONT_CONF).unlink(missing_ok=True)
        except OSError:
            pass
        persisted = write_mode('adguard')
        unbound_up = run(['/bin/systemctl', 'restart', 'unbound'], timeout=40).returncode == 0
        result = run(['/bin/systemctl', 'start', 'adguardhome'], timeout=120)
        if result.returncode:
            return fail('adguard_start_failed', 'AdGuard Home could not start; plain recursive mode stays active.')
        return ok('set_dns_stack', 'AdGuard filtering DNS active'
                  + (' (Unbound fallback on 5335).' if unbound_up
                     else ' (Unbound fallback did not restart, so there is no resolver fallback).')
                  + ('' if persisted else ' Saving the mode for next boot failed.'))
    if not ns_list:
        return fail('no_upstream', 'No hotel nameserver is available for plain recursive mode.')
    conf = ('# Generated by the TravelPi helper: plain recursive mode (Unbound on :53, AdGuard off).\n'
            'server:\n  port: 53\n  interface: 0.0.0.0\n'
            '  access-control: 127.0.0.1 allow\n  access-control: 192.168.200.0/24 allow\n'
            'forward-zone:\n  name: "."\n'
            + ''.join('  forward-addr: ' + ns + '\n' for ns in ns_list))
    try:
        Path(UNBOUND_FRONT_CONF).write_text(conf)
    except OSError:
        return fail('unbound_conf_unwritable', 'Unbound drop-in could not be written.')
    check = run(['/usr/sbin/unbound-checkconf'], timeout=20)
    if check.returncode:
        try:
            Path(UNBOUND_FRONT_CONF).unlink(missing_ok=True)
        except OSError:
            pass
        return fail('unbound_conf_invalid', 'Recursive-mode config failed validation; nothing changed.')
    run(['/bin/systemctl', 'stop', 'adguardhome'], timeout=90)
    restart = run(['/bin/systemctl', 'restart', 'unbound'], timeout=40)
    if restart.returncode:
        try:
            Path(UNBOUND_FRONT_CONF).unlink(missing_ok=True)
        except OSError:
            pass
        run(['/bin/systemctl', 'restart', 'unbound'], timeout=40)
        run(['/bin/systemctl', 'start', 'adguardhome'], timeout=120)
        return fail('unbound_start_failed', 'Unbound could not take over :53; the filtered stack was restored.')
    persisted = write_mode('unbound')
    return ok('set_dns_stack', 'Plain recursive DNS active (Unbound on :53, AdGuard stopped).'
              + ('' if persisted else ' Saving the mode for next boot failed.'))


AP_NETWORK_FILE = '/etc/systemd/network/070-travelpi-ap.network'
AP_RA_OFF_DROPIN = '/etc/systemd/network/070-travelpi-ap.network.d/ra-off.conf'


def set_ipv6(request):
    """Router advertisements are owned by systemd-networkd (ADR 0006), not
    radvd. On/off is a drop-in that sets IPv6SendRA=no; networkctl
    reconfigure applies it without flushing the AP addresses (Address= in the
    .network file keeps them networkd-owned)."""
    mode = str(request.get('mode') or '')
    if mode not in ('on', 'off'):
        return fail('invalid_mode', 'IPv6 mode must be on or off')
    if not Path(AP_NETWORK_FILE).exists():
        return fail('unavailable', 'The networkd AP profile is not installed on this host; router advertisements cannot be changed.')
    if mode == 'on' and ula_prefix() is None:
        return fail('unavailable', 'No ULA prefix is configured in ' + ULA_PREFIX_FILE + '; run travelpi-ula-init (make deploy does) before advertising IPv6.')
    dropin = Path(AP_RA_OFF_DROPIN)
    previous = dropin.read_text() if dropin.exists() else None
    try:
        if mode == 'off':
            dropin.parent.mkdir(parents=True, exist_ok=True)
            dropin.write_text('[Network]\nIPv6SendRA=no\n')
        else:
            dropin.unlink(missing_ok=True)
    except OSError:
        return fail('ra_change_failed', 'Router advertisement setting could not be written; nothing changed.')

    def restore():
        try:
            if previous is None:
                dropin.unlink(missing_ok=True)
            else:
                dropin.write_text(previous)
        except OSError:
            pass
        run(['/usr/bin/networkctl', 'reload'], timeout=30)
        run(['/usr/bin/networkctl', 'reconfigure', LAN], timeout=30)

    reload_result = run(['/usr/bin/networkctl', 'reload'], timeout=30)
    result = run(['/usr/bin/networkctl', 'reconfigure', LAN], timeout=30) if reload_result.returncode == 0 else reload_result
    if result.returncode:
        restore()
        return fail('ra_change_failed', 'systemd-networkd could not apply the change; the previous setting was restored.')
    return ok('set_ipv6', 'Router advertisements on; LAN devices get ULA (private IPv6) addresses.'
              if mode == 'on' else 'Router advertisements stopped; IPv6 off for LAN devices.')


def set_sqm_mode(request):
    mode = str(request.get('mode') or '')
    if mode not in ('auto', 'manual', 'off'):
        return fail('invalid_mode', 'SQM mode must be auto, manual, or off')

    def set_env(value):
        try:
            lines = Path(SQM_ENV_FILE).read_text(errors='replace').splitlines()
        except OSError:
            lines = []
        out, replaced = [], False
        for line in lines:
            if line.startswith('TRAVELPI_SQM_AUTOTUNE='):
                out.append('TRAVELPI_SQM_AUTOTUNE=' + value)
                replaced = True
            else:
                out.append(line)
        if not replaced:
            out.append('TRAVELPI_SQM_AUTOTUNE=' + value)
        try:
            write_private_file(SQM_ENV_FILE, '\n'.join(out) + '\n', 0o644)
            return True
        except OSError:
            return False

    if mode == 'off':
        stopped = run(['/bin/systemctl', 'stop', SQM_SERVICE], timeout=30).returncode == 0
        run(['/bin/systemctl', 'stop', 'travelpi-sqm-tune.timer'], timeout=20)
        persisted = set_env('no')
        cake_state = ((status()['status'].get('cake') or {}).get('state'))
        cake_gone = cake_state != 'active'
        return ok('set_sqm_mode', ('Traffic shaping off; the CAKE qdisc is removed.'
                  if stopped and cake_gone
                  else 'Traffic shaping stop was requested; the CAKE qdisc is still reported active.')
                  + ('' if persisted else ' Saving the mode for next boot failed.'))
    persisted = set_env('yes' if mode == 'auto' else 'no')
    result = run(['/bin/systemctl', 'restart', SQM_SERVICE], timeout=45)
    if result.returncode:
        return fail('sqm_restart_failed', 'SQM service could not restart.')
    if mode == 'auto':
        run(['/bin/systemctl', 'restart', 'travelpi-sqm-tune.timer'], timeout=20)
    else:
        run(['/bin/systemctl', 'stop', 'travelpi-sqm-tune.timer'], timeout=20)
    tail = '' if persisted else ' Saving the mode for next boot failed.'
    return ok('set_sqm_mode', ('Traffic shaping auto-tunes from probes.'
              if mode == 'auto' else 'Traffic shaping pinned to the dashboard rate.') + tail)


def set_cpu_governor(request):
    governor = str(request.get('governor') or '')
    if governor not in CPU_GOVERNORS:
        return fail('invalid_governor', 'Governor must be conservative, ondemand, or performance')
    persisted = True
    try:
        write_private_file(POWER_PROFILE_ENV, 'GOVERNOR=' + governor + '\n', 0o644)
    except OSError:
        persisted = False
    applied = run(['/bin/sh', '-c',
                   'for d in /sys/devices/system/cpu/cpu*/cpufreq; do echo ' + governor +
                   ' > "$d/scaling_governor"; done'])
    if applied.returncode:
        return fail('governor_failed', 'CPU governor could not be applied live.')
    if not persisted:
        return ok('set_cpu_governor',
                  'CPU governor set to ' + governor + ' for this boot; saving it for next boot failed.')
    return ok('set_cpu_governor', 'CPU governor set to ' + governor + ' and saved for next boot.')


def reclaim_memory(request):
    """Manual counterpart of the memory guard's first aid: sync and drop
    kernel page caches. It never stops services and never kills processes;
    swap only frees as processes exit."""
    def avail():
        try:
            for line in Path('/proc/meminfo').read_text().splitlines():
                if line.startswith('MemAvailable:'):
                    return int(line.split()[1]) // 1024
        except (OSError, ValueError, IndexError):
            return None
        return None
    before = avail()
    run(['/bin/sync'], timeout=20)
    drop = run(['/bin/sh', '-c', 'echo 3 > /proc/sys/vm/drop_caches'], timeout=60)
    if drop.returncode:
        return fail('reclaim_failed', 'Kernel cache drop was refused.')
    after = avail()
    freed = after - before if (before is not None and after is not None) else None
    note = 'Page caches dropped' + (': ' + str(max(0, freed)) + ' MB newly available.'
                                    if freed is not None else '.')
    return ok('reclaim_memory', note)


def action(name, request):
    try:
        return _action(name, request)
    except Exception as exc:
        # Never leak a traceback or secrets from request fields: log only the
        # exception class and action name.
        sys.stderr.write('travelpi-cockpit: %s failed: %s\n' % (name, type(exc).__name__))
        return fail('internal_error', 'The helper hit an unexpected error; check status before retrying.')


def _action(name, request):
    if name not in ACTION_FIELDS or request.get('action') != name:
        return fail('unknown_action', 'Action is not allowed')
    extra = set(request) - ACTION_FIELDS[name]
    if extra:
        return fail('unknown_fields', 'Unknown request fields are not allowed')
    if not confirm(request):
        return fail('confirmation_required', 'Explicit confirmation is required')
    if name == 'vpn_toggle':
        return vpn_toggle(request)
    if name == 'tailscale_auth':
        return tailscale_auth(request)
    if name == 'connect_hotel':
        return connect_hotel(request)
    if name == 'apply_mac_clone':
        return clone_mac(request)
    if name == 'set_ap_radio':
        return ap_profile(request)
    if name == 'set_ap_identity':
        return set_ap_identity(request)
    if name == 'set_wan_band':
        return set_wan_band(request)
    if name == 'wan_flip':
        return wan_flip(request)
    if name == 'reset_radios':
        return reset_radios(request)
    if name == 'set_cake_rate':
        return cake_rate(request)
    if name == 'restart_services':
        return restart_services(request)
    if name == 'set_dns_stack':
        return set_dns_stack(request)
    if name == 'set_ipv6':
        return set_ipv6(request)
    if name == 'set_sqm_mode':
        return set_sqm_mode(request)
    if name == 'set_cpu_governor':
        return set_cpu_governor(request)
    if name == 'reclaim_memory':
        return reclaim_memory(request)
    if name == 'wake_peer':
        return wake_peer(request)
    if name == 'reboot':
        result = run(['/bin/systemctl', 'reboot'])
        return ok(name, 'Reboot requested') if result.returncode == 0 else fail('reboot_failed', 'Reboot request failed')
    return fail('unknown_action', 'Action is not allowed')


def status_cached():
    """Cache the status payload briefly so repeat page loads render instantly.

    Mutations and action responses always compute fresh status(); only the
    read-only status command consults the cache. Uses monotonic time so an
    unsynced clock (no RTC) cannot poison freshness."""
    cached = fresh_cache(STATUS_CACHE, ('response',), STATUS_CACHE_TTL)
    response = cached.get('response') if cached else None
    if isinstance(response, dict) and response.get('ok'):
        return response
    try:
        response = status()
    except Exception:
        response = fail('status_probe_failed', 'Status probe failed on the host; try again')
    store_cache(STATUS_CACHE, response=response)
    return response


# --- DHCPv6 prefix-delegation probe (read-only) -------------------------------
# One SOLICIT with an IA_PD option; the answer is only parsed, never REQUESTed,
# so no lease is taken. Packet build/parse are pure; socket I/O is the seam
# pd_udp_exchange (tests replace PD_TRANSPORT) and pd_euid (PD_EUID).
DHCPV6_SERVERS = 'ff02::1:2'
DHCPV6_SERVER_PORT = 547
DHCPV6_CLIENT_PORT = 546
PD_ATTEMPTS = 3
PD_ATTEMPT_TIMEOUT = 3.0
PD_TOTAL_BUDGET = 12.0
PD_IF_INET6 = Path('/proc/net/if_inet6')
DHCPV6_STATUS_NAMES = {1: 'UnspecFail', 2: 'NoAddrsAvail', 3: 'NoBinding', 4: 'NotOnLink',
                       5: 'UseMulticast', 6: 'NoPrefixAvail'}


def build_pd_solicit(mac, xid):
    """SOLICIT with DUID-LL client id, elapsed time and one IA_PD (iaid 1, t1=t2=0)."""
    if len(mac) != 6 or len(xid) != 3:
        raise ValueError('mac must be 6 bytes and xid 3 bytes')
    duid = (3).to_bytes(2, 'big') + (1).to_bytes(2, 'big') + bytes(mac)
    ia_pd = (1).to_bytes(4, 'big') + (0).to_bytes(4, 'big') + (0).to_bytes(4, 'big')
    packet = bytes([1]) + bytes(xid)
    for code, body in ((1, duid), (8, b'\x00\x00'), (25, ia_pd)):
        packet += code.to_bytes(2, 'big') + len(body).to_bytes(2, 'big') + body
    return packet


def _dhcpv6_options(data):
    """Yield (code, body) options; raise ValueError when the framing is malformed."""
    index = 0
    while index < len(data):
        if index + 4 > len(data):
            raise ValueError('truncated option header')
        code = int.from_bytes(data[index:index + 2], 'big')
        length = int.from_bytes(data[index + 2:index + 4], 'big')
        body = data[index + 4:index + 4 + length]
        if len(body) != length:
            raise ValueError('truncated option body')
        yield code, body
        index += 4 + length


def parse_pd_reply(data, xid):
    """Parse an ADVERTISE/REPLY for our transaction id.

    Returns None for anything that is not a well-formed answer to us (wrong
    message type, wrong xid, truncated). Otherwise a dict with msg_type,
    status (int or None), prefix, prefix_len, valid_s.
    """
    if not isinstance(data, (bytes, bytearray)) or len(data) < 4:
        return None
    if data[0] not in (2, 7) or bytes(data[1:4]) != bytes(xid):
        return None
    result = {'msg_type': data[0], 'status': None, 'prefix': None, 'prefix_len': None, 'valid_s': None}
    try:
        for code, body in _dhcpv6_options(bytes(data[4:])):
            if code == 13 and len(body) >= 2:
                result['status'] = int.from_bytes(body[:2], 'big')
            elif code == 25:
                if len(body) < 12:
                    return None
                for sub, subbody in _dhcpv6_options(body[12:]):
                    if sub == 13 and len(subbody) >= 2:
                        result['status'] = int.from_bytes(subbody[:2], 'big')
                    elif sub == 26:
                        if len(subbody) < 25:
                            return None
                        plen = subbody[8]
                        if plen > 128:
                            return None
                        result['valid_s'] = int.from_bytes(subbody[4:8], 'big')
                        result['prefix_len'] = plen
                        result['prefix'] = str(ipaddress.IPv6Address(bytes(subbody[9:25])))
    except ValueError:
        return None
    return result


def match_dhcpv6_datagram(datagram):
    """Strip the UDP header from a raw IPPROTO_UDP read; None unless sport 547 / dport 546."""
    if len(datagram) < 8:
        return None
    sport = int.from_bytes(datagram[0:2], 'big')
    dport = int.from_bytes(datagram[2:4], 'big')
    if sport != DHCPV6_SERVER_PORT or dport != DHCPV6_CLIENT_PORT:
        return None
    return bytes(datagram[8:])


def pd_euid():
    return os.geteuid()


# Privilege seam for the CLI gates: tests replace it to exercise the refusal
# path whether or not the suite itself runs as root.
EUID = pd_euid


def pd_open_sockets(interface):
    """Open the raw listener and the multicast sender bound to `interface`.

    Returns (raw, sender, destination). Closes whatever was opened if a later
    step fails. Raises OSError on failure."""
    import socket
    index = socket.if_nametoindex(interface)
    bind_to_device = getattr(socket, 'SO_BINDTODEVICE', 25)
    raw = socket.socket(socket.AF_INET6, socket.SOCK_RAW, socket.IPPROTO_UDP)
    sender = None
    try:
        sender = socket.socket(socket.AF_INET6, socket.SOCK_DGRAM)
        raw.setsockopt(socket.SOL_SOCKET, bind_to_device, interface.encode())
        sender.setsockopt(socket.SOL_SOCKET, bind_to_device, interface.encode())
        sender.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_MULTICAST_HOPS, 1)
    except BaseException:
        raw.close()
        if sender is not None:
            sender.close()
        raise
    return raw, sender, (DHCPV6_SERVERS, DHCPV6_SERVER_PORT, 0, index)


# Socket-opening seam: tests substitute loopback sockets for the raw/multicast pair.
PD_SOCKETS = pd_open_sockets


def pd_udp_exchange(interface, packet, xid, timeout):
    """Socket seam: send one SOLICIT, return (payload, source) for a matching answer or None.

    Sends from an ephemeral UDP socket and listens on a raw UDP socket, so it
    never competes with NetworkManager for UDP 546. Raises OSError on failure.
    """
    import select
    raw, sender, destination = PD_SOCKETS(interface)
    try:
        sender.sendto(packet, destination)
        deadline = time.monotonic() + timeout
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            ready, _, _ = select.select([raw], [], [], remaining)
            if not ready:
                return None
            datagram, source = raw.recvfrom(2048)
            payload = match_dhcpv6_datagram(datagram)
            if payload is not None and len(payload) >= 4 and payload[1:4] == bytes(xid):
                return payload, source[0].split('%')[0]
    finally:
        raw.close()
        sender.close()


PD_TRANSPORT = pd_udp_exchange
PD_EUID = pd_euid


def _pd_result(state, detail, **extra):
    pd = {'state': state, 'prefix': None, 'prefix_len': None, 'valid_s': None, 'server': None, 'detail': detail}
    pd.update(extra)
    return {'ok': True, 'action': 'pd_probe', 'pd': pd}


def _pd_has_link_local(interface):
    try:
        for line in PD_IF_INET6.read_text().splitlines():
            fields = line.split()
            if len(fields) >= 6 and fields[5] == interface and fields[0].startswith('fe80'):
                return True
    except OSError:
        pass
    return False


def dhcpv6_pd_probe(interface=WAN):
    if PD_EUID() != 0:
        return _pd_result('unavailable', 'Administrative access is required to check prefix delegation.')
    try:
        mac_text = (DEVICE_SYS / interface / 'address').read_text().strip()
        state = (DEVICE_SYS / interface / 'operstate').read_text().strip()
    except OSError:
        return _pd_result('unavailable', interface + ' is not present, so prefix delegation cannot be checked.')
    if state != 'up':
        return _pd_result('unavailable', interface + ' is not connected, so prefix delegation cannot be checked.')
    if not MAC_RE.match(mac_text):
        return _pd_result('unavailable', interface + ' has no usable hardware address.')
    if not _pd_has_link_local(interface):
        return _pd_result('unavailable', interface + ' has no IPv6 link-local address yet.')
    mac = bytes(int(part, 16) for part in mac_text.split(':'))
    xid = os.urandom(3)
    packet = build_pd_solicit(mac, xid)
    started = time.monotonic()
    answered = None
    for _ in range(PD_ATTEMPTS):
        budget = PD_TOTAL_BUDGET - (time.monotonic() - started)
        if budget <= 0:
            break
        try:
            answered = PD_TRANSPORT(interface, packet, xid, min(PD_ATTEMPT_TIMEOUT, budget))
        except OSError as error:
            return _pd_result('unavailable', 'Could not send the DHCPv6 request on ' + interface + ': ' + (error.strerror or 'socket error') + '.')
        if answered:
            break
    if not answered:
        return _pd_result('not_offered', 'No DHCPv6 server answered on this network (no prefix delegation offered).')
    reply = parse_pd_reply(answered[0], xid)
    server = answered[1]
    if reply is None:
        return _pd_result('not_offered', 'A DHCPv6 server answered but the reply was not understood; treating prefix delegation as not offered.', server=server)
    if reply['prefix'] is not None and reply['status'] in (None, 0):
        return _pd_result('offered', 'The network offers prefix delegation: ' + reply['prefix'] + '/' + str(reply['prefix_len']) + '.',
                          prefix=reply['prefix'], prefix_len=reply['prefix_len'], valid_s=reply['valid_s'], server=server)
    if reply['status'] == 6:
        return _pd_result('not_offered', 'The DHCPv6 server answered NoPrefixAvail: it has no prefix to delegate.', server=server)
    if reply['status']:
        name = DHCPV6_STATUS_NAMES.get(reply['status'], 'status ' + str(reply['status']))
        return _pd_result('not_offered', 'The DHCPv6 server answered ' + name + ' instead of a prefix.', server=server)
    return _pd_result('not_offered', 'A DHCPv6 server answered without offering a prefix.', server=server)


def main():
    command = sys.argv[1] if len(sys.argv) >= 2 else ''
    if command == 'status':
        response = status_cached()
    elif command == 'probe':
        target = None
        if len(sys.argv) > 2:
            target = validate_probe_target(sys.argv[2])
            if target is None:
                response = fail('invalid_probe_target', 'Probe target must be a bare hostname')
                print(json.dumps(response, separators=(',', ':')))
                return 1
        response = probe(target or 'google.com')
    elif command == 'scan':
        if EUID() != 0:
            response = fail('not_privileged', 'Administrative access is required for this scan')
        else:
            response = wifi_scan()
    elif command == 'pd':
        if EUID() != 0:
            response = fail('not_privileged', 'Administrative access is required for this check')
        else:
            response = dhcpv6_pd_probe(WAN)
    elif command == 'readiness':
        response = readiness_status()
    elif command == 'portal':
        # Fresh portal probe for the dashboard's re-check button (cache
        # bypass with 'fresh'); display-only, never automates portal login.
        response = ok('portal', 'Portal probe completed.')
        response['portal'] = portal_status(force=len(sys.argv) > 2 and sys.argv[2] == 'fresh')
    elif command == 'action':
        if EUID() != 0:
            print(json.dumps(fail('not_privileged', 'Administrative access is required for this action')))
            return 1
        request = json_lines(sys.stdin.read(65536))
        if not isinstance(request, dict):
            response = fail('invalid_request', 'Expected one JSON object')
        else:
            response = action(request.get('action'), request)
    else:
        response = fail('invalid_command', 'Command is not allowed')
    print(json.dumps(response, separators=(',', ':')))
    return 0 if response.get('ok') else 1


if __name__ == '__main__':
    raise SystemExit(main())
