def band_for_frequency(frequency):
    """Band name for a frequency in MHz, or None when unknown."""
    try:
        frequency = float(frequency)
    except (TypeError, ValueError):
        return None
    if 2400 <= frequency < 2500:
        return '2.4ghz'
    if 4900 <= frequency < 5925:
        return '5ghz'
    if 5925 <= frequency <= 7125:
        return '6ghz'
    return None


def parse_radio_capabilities(iw_info):
    bands = set()
    capabilities = set()
    supported = {'2.4ghz': [], '5ghz': [], '6ghz': []}
    # A band counts only when the radio reports at least one enabled
    # frequency in it. Radar (DFS) frequencies still count: a WAN client may
    # associate on them even though an unattended AP may not own them.
    for match in re.finditer(r'\*\s+(\d+(?:\.\d+)?)\s+MHz([^\n]*)', iw_info or ''):
        if 'disabled' in match.group(2):
            continue
        band = band_for_frequency(match.group(1))
        if band:
            bands.add(band)
    # Per-band channel numbers as the hardware reports them (iw phy info
    # prints "* 5520 MHz [104] (24.0 dBm) (no IR, radar detection)").
    # Radar-detection channels are excluded: an unattended AP must not
    # own a DFS channel.
    for match in re.finditer(r'\*\s+(\d+(?:\.\d+)?)\s+MHz\s+\[(\d+)\]([^\n]*)', iw_info or ''):
        frequency = float(match.group(1))
        channel = int(match.group(2))
        rest = match.group(3)
        if 'radar detection' in rest or 'disabled' in rest or 'no IR' in rest:
            # Radar (DFS) channels are excluded: an unattended AP must not
            # own a DFS channel. Disabled channels are excluded: hostapd
            # would fail on them. "no IR" (no initiating radiation) channels
            # cannot host an AP, though a WAN client may still associate on
            # them, so the bands set above still counts them.
            continue
        band = band_for_frequency(frequency)
        if band:
            supported[band].append(channel)
    for band in supported:
        supported[band] = sorted(set(supported[band]))
    if re.search(r'\bHT(?:20|40)?/', iw_info or ''):
        capabilities.add('wifi4')
    if 'VHT' in (iw_info or ''):
        capabilities.add('wifi5')
    if 'HE' in (iw_info or ''):
        capabilities.add('wifi6')
    if '6ghz' in bands and 'wifi6' in capabilities:
        capabilities.add('wifi6e')
    if 'EHT' in (iw_info or ''):
        capabilities.add('wifi7')
    if re.search(r'^\s*\*\s+AP\s*$', iw_info or '', re.M):
        capabilities.add('ap')
    ordered_bands = [band for band in ('2.4ghz', '5ghz', '6ghz') if band in bands]
    ordered_caps = [cap for cap in ('ap', 'wifi4', 'wifi5', 'wifi6', 'wifi6e', 'wifi7') if cap in capabilities]
    return {'bands': ordered_bands, 'capabilities': ordered_caps, 'supported_channels': supported}


def interface_hardware(interface):
    role = 'wan' if interface == WAN else ('ap' if interface == LAN else 'unknown')
    record = {'interface': interface, 'role': role, 'present': False,
              'label': 'Pi internal Wi-Fi' if role == 'wan' else ('USB Wi-Fi adapter' if role == 'ap' else 'Wi-Fi radio'),
              'model': None, 'transport': None, 'driver': None,
              'bands': [], 'capabilities': []}
    device = DEVICE_SYS / interface
    if not device.exists():
        return record
    record['present'] = True
    try:
        path = str(device.joinpath('device').resolve())
    except OSError:
        path = ''
    driver_path = device / 'device' / 'driver'
    try:
        record['driver'] = driver_path.resolve().name
    except OSError:
        record['driver'] = 'unknown'
    try:
        phy_name = (device / 'phy80211' / 'name').read_text().strip()
        iw_info = text(['/sbin/iw', 'phy', phy_name, 'info']) if phy_name else ''
        radio_caps = parse_radio_capabilities(iw_info)
        record.update(radio_caps)
    except Exception:
        pass
    if 'mmc1' in path or interface == WAN:
        record.update(label='Pi internal Wi-Fi', model='Broadcom BCM43430', transport='SDIO')
        return record
    if 'usb' in path:
        vendor = model = ''
        try:
            properties = text(['/usr/bin/udevadm', 'info', '--query=property', '--path', str(device)])
            for line in properties.splitlines():
                if line.startswith('ID_VENDOR='):
                    vendor = line.split('=', 1)[1].replace('_', ' ')
                elif line.startswith('ID_MODEL='):
                    model = line.split('=', 1)[1].replace('_', ' ')
        except Exception:
            pass
        record.update(label='USB Wi-Fi adapter', model=(vendor + ' ' + model).strip() or 'USB wireless adapter', transport='USB')
        return record
    record.update(label='Wi-Fi radio', model='Unknown hardware', transport='Unknown')
    return record


def ipv4_address(interface):
    try:
        output = text(['/sbin/ip', '-4', '-o', 'addr', 'show', 'dev', interface])
    except Exception:
        return None
    match = re.search(r'inet\s+(\S+)', output)
    return match.group(1) if match else None


def ensure_ipv6_link_local(interface):
    """Router advertisements must be sourced from a link-local address
    (RFC 4861). The kernel regenerates link-local only on an IPv6 enable
    edge, so a flushed interface keeps no link-local until it is toggled;
    the toggle also removes global v6 addresses, which is why the AP's
    ULA gateway is (re)applied after it. Returns True when a toggle ran.
    """
    try:
        out = text(['/sbin/ip', '-6', 'addr', 'show', 'dev', interface, 'scope', 'link'])
        if 'fe80::' in out:
            return False
    except Exception:
        pass
    run(['/usr/sbin/sysctl', '-qw', 'net.ipv6.conf.%s.disable_ipv6=1' % interface], timeout=10)
    run(['/usr/sbin/sysctl', '-qw', 'net.ipv6.conf.%s.disable_ipv6=0' % interface], timeout=10)
    try:
        out = text(['/sbin/ip', '-6', 'addr', 'show', 'dev', interface, 'scope', 'link'])
        return 'fe80::' in out
    except Exception:
        return False


def split_terse(line):
    """Split one `nmcli -t` line on unescaped ':' and unescape '\\:' and '\\\\'."""
    fields, cur, i = [], [], 0
    while i < len(line):
        ch = line[i]
        if ch == '\\' and i + 1 < len(line):
            cur.append(line[i + 1])
            i += 2
            continue
        if ch == ':':
            fields.append(''.join(cur))
            cur = []
        else:
            cur.append(ch)
        i += 1
    fields.append(''.join(cur))
    return fields


def active_profile(interface):
    try:
        output = text(['/usr/bin/nmcli', '-t', '-f', 'NAME,DEVICE', 'connection', 'show', '--active'])
    except Exception:
