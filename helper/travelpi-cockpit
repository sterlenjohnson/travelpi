class HostAdapter:
    """Private seam for fixed host commands; tests may replace this adapter."""

    def run(self, argv, *, input_text=None, timeout=HELPER_TIMEOUT, check=False):
        try:
            return subprocess.run(argv, input=input_text, text=True, stdout=subprocess.PIPE,
                                  stderr=subprocess.PIPE, timeout=timeout, check=check,
                                  env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'})
        except subprocess.TimeoutExpired as expired:
            # A hung host command must not abort the caller: restore-on-fail
            # paths rely on a nonzero result (124 is timeout(1)'s convention).
            return subprocess.CompletedProcess(argv, 124, '', 'timed out after %ss' % expired.timeout)


HOST = HostAdapter()


